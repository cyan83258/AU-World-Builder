/**
 * AU World Builder v2.1 - SillyTavern Extension
 *
 * v2.0: multi-parsing, selective-regen, history, custom-prompts,
 *        injection-ctrl, token-count, smart-auto-update, lorebook, retry
 * v2.1: C Diff-view | D Custom-sections+on/off | H chatData-cleanup | J Per-section-injection
 */
(function () {
    'use strict';

    /* ================================================================
       SECTION 1 — CONSTANTS & DEFAULTS
       ================================================================ */
    const extensionName  = 'AU-World-Builder';
    const MODULE_PREFIX  = 'au_wb_';
    const MAX_HISTORY    = 20;
    const MAX_RETRIES    = 3;
    const RETRY_BASE_MS  = 1500;

    /* Built-in sections ------------------------------------------------ */
    const BUILTIN_SECTIONS = [
        { id:'world',        label:'세계관',        tag:'WORLD',         injHeader:'AU World Setting' },
        { id:'charSetting',  label:'{{char}} 설정', tag:'CHAR',          injHeader:'{{char}} - AU Character Setting' },
        { id:'userSetting',  label:'{{user}} 설정', tag:'USER',          injHeader:'{{user}} - AU Character Setting' },
        { id:'charClothing', label:'{{char}} 복장', tag:'CHAR_CLOTHING', injHeader:'{{char}} - Current Clothing/Appearance' },
        { id:'userClothing', label:'{{user}} 복장', tag:'USER_CLOTHING', injHeader:'{{user}} - Current Clothing/Appearance' },
    ];

    /* Prompt templates ------------------------------------------------- */
    const DEFAULT_INITIAL_PROMPT = [
        'You are an expert creative writer and worldbuilder.',
        'Create a rich, immersive AU based on the given concept.',
        '',
        '{{GUIDELINES}}',
        '',
        '## AU Concept',
        '{{CONCEPT}}',
        '',
        '## Character Information',
        '- Name: {{CHAR_NAME}}',
        '- Description: {{CHAR_DESC}}',
        '- Personality: {{CHAR_PERS}}',
        '- Scenario: {{CHAR_SCENE}}',
        '',
        '## User Information',
        '- Name: {{USER_NAME}}',
        '- Persona: {{USER_PERSONA}}',
        '',
        '## OUTPUT FORMAT (STRICTLY follow with EXACT markers)',
        '',
        '{{OUTPUT_FORMAT}}',
        '',
        '{{LANG_INSTRUCTION}}',
    ].join('\n');

    const DEFAULT_UPDATE_PROMPT = [
        'You are an expert AU content editor.',
        'Update the existing AU settings based on recent story developments.',
        'PRESERVE existing content; only MODIFY or ADD based on new chat messages.',
        '',
        '## Character Names',
        '- Character: {{CHAR_NAME}}',
        '- User: {{USER_NAME}}',
        '',
        '## EXISTING AU SETTINGS',
        '{{EXISTING_SETTINGS}}',
        '',
        '## CHAT MESSAGES (#{{START}} – #{{END}})',
        '{{MESSAGES}}',
        '',
        '## OUTPUT (same tag format)',
        '{{OUTPUT_FORMAT}}',
        '',
        '{{LANG_INSTRUCTION}}',
    ].join('\n');

    const DEFAULT_GENRE_PROMPT = [
        'Based on the AU world setting below, generate a concise genre/tone prompt (2-4 sentences).',
        '',
        '## World Setting',
        '{{WORLD_SETTING}}',
        '',
        'Cover: genre, mood/atmosphere, writing style, themes.',
        '{{LANG_INSTRUCTION}}',
    ].join('\n');

    const DEFAULT_SECTION_PROMPT = [
        'You are an expert AU worldbuilder.',
        'Regenerate ONLY the {{SECTION_LABEL}} section for this AU.',
        '',
        '## AU Concept: {{CONCEPT}}',
        '## Character: {{CHAR_NAME}} — {{CHAR_DESC}}',
        '## User: {{USER_NAME}} — {{USER_PERSONA}}',
        '',
        '## Current AU Settings (context)',
        '{{EXISTING_SETTINGS}}',
        '',
        'Now regenerate ONLY the section wrapped in the tag below. Keep other context consistent.',
        '{{SECTION_TAG}}',
        '',
        '{{LANG_INSTRUCTION}}',
    ].join('\n');

    const DEFAULT_SMART_ANALYSIS_PROMPT = [
        'You are a story analyst. Read the following recent chat messages and decide whether the AU world settings need to be updated.',
        '',
        '## Current AU Summary',
        '{{WORLD_SUMMARY}}',
        '',
        '## Recent Messages (#{{START}} – #{{END}})',
        '{{MESSAGES}}',
        '',
        'Reply with EXACTLY one of:',
        '- UPDATE_NEEDED: <brief reason>',
        '- NO_UPDATE_NEEDED',
        '',
        'Be strict: minor dialogue or emotions are NOT updates.',
    ].join('\n');

    function newSectionCfg() { return { enabled:true, injPos:1, injDepth:4, injRole:0 }; }

    const defaultSettings = {
        enabled: true,
        apiSource: 'sillytavern',
        connectionProfile: '',
        customApiUrl: '',
        customApiKey: '',
        customApiModel: '',
        customApiMaxTokens: 4000,
        customApiTimeout: 120,
        autoUpdateEnabled: false,
        autoUpdateInterval: 5,
        smartAutoUpdate: true,
        genrePromptEnabled: false,
        debugMode: false,
        outputLanguage: 'korean',
        presets: [],
        chatData: {},
        genOptions: { cliche:'allow', relation:'first', original:'break', mood:'light' },
        /* D + J ---- */
        sectionConfig: {
            world:        newSectionCfg(),
            charSetting:  newSectionCfg(),
            userSetting:  newSectionCfg(),
            charClothing: newSectionCfg(),
            userClothing: newSectionCfg(),
            genre:        newSectionCfg(),
        },
        customSections: [],
        customPrompts: { initial:'', update:'', genre:'', section:'', smartAnalysis:'' },
    };

    /* ================================================================
       SECTION 2 — UTILITY HELPERS
       ================================================================ */
    function log()      { console.log  ('['+extensionName+']', ...arguments); }
    function logError() { console.error('['+extensionName+']', ...arguments); }
    function escapeHtml(t) { var d=document.createElement('div'); d.textContent=t; return d.innerHTML; }
    function estimateTokens(t) {
        if(!t) return 0;
        var cjk = (t.match(/[\u3000-\u9fff\uac00-\ud7af\uff00-\uffef]/g)||[]).length;
        return Math.ceil(cjk*0.7 + (t.length-cjk)/4);
    }
    function escapeRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'); }
    function cleanSection(t) { return (t||'').replace(/^#+\s*.+$/m,'').replace(/^---+$/gm,'').trim(); }

    /** C — line-level LCS diff */
    function diffLines(oldText, newText) {
        var oL = (oldText||'').split('\n'), nL = (newText||'').split('\n');
        var m = oL.length, n = nL.length, dp = [];
        for (var i=0;i<=m;i++) { dp[i]=[]; for(var j=0;j<=n;j++){
            if(!i||!j) dp[i][j]=0;
            else if(oL[i-1]===nL[j-1]) dp[i][j]=dp[i-1][j-1]+1;
            else dp[i][j]=Math.max(dp[i-1][j],dp[i][j-1]);
        }}
        var res=[], ii=m, jj=n;
        while(ii>0||jj>0){
            if(ii>0&&jj>0&&oL[ii-1]===nL[jj-1]){res.unshift({type:'same',text:oL[ii-1]});ii--;jj--;}
            else if(jj>0&&(!ii||dp[ii][jj-1]>=dp[ii-1][jj])){res.unshift({type:'added',text:nL[jj-1]});jj--;}
            else{res.unshift({type:'removed',text:oL[ii-1]});ii--;}
        }
        return res;
    }

    /* ================================================================
       SECTION 3 — SETTINGS MANAGEMENT
       ================================================================ */
    function getExtFolderPath() {
        try { var s=document.currentScript; if(s&&s.src) return s.src.split('?')[0].split('#')[0].replace(/\/[^/]*$/,''); } catch(_){}
        return 'data/default-user/extensions/AU-World-Builder';
    }
    var extFolderPath = getExtFolderPath();

    function getSettings() {
        var ext;
        try { var ctx=SillyTavern.getContext(); ext=ctx&&ctx.extensionSettings; } catch(_){}
        ext = ext || window.extension_settings || {};
        window.extension_settings = ext;
        if(!ext[extensionName]) ext[extensionName]={};
        var s = ext[extensionName];
        for(var k in defaultSettings) {
            if(s[k]===undefined) s[k] = typeof defaultSettings[k]==='object'&&defaultSettings[k]!==null
                ? JSON.parse(JSON.stringify(defaultSettings[k])) : defaultSettings[k];
        }
        migrateV2(s);
        return s;
    }

    /** Migrate from v2.0 sectionToggles + global injection → v2.1 per-section */
    function migrateV2(s) {
        if(s.sectionToggles && !s._mig21) {
            var ot=s.sectionToggles, pos=s.injectionPosition!=null?s.injectionPosition:1,
                dep=s.injectionDepth!=null?s.injectionDepth:4, rol=s.injectionRole!=null?s.injectionRole:0;
            if(!s.sectionConfig) s.sectionConfig={};
            ['world','charSetting','userSetting','charClothing','userClothing','genre'].forEach(function(k){
                if(!s.sectionConfig[k]) s.sectionConfig[k]={};
                s.sectionConfig[k].enabled = ot[k]!==false;
                s.sectionConfig[k].injPos  = pos;
                s.sectionConfig[k].injDepth= dep;
                s.sectionConfig[k].injRole = rol;
            });
            delete s.sectionToggles; delete s.injectionPosition; delete s.injectionDepth; delete s.injectionRole;
            s._mig21 = true;
        }
        try { SillyTavern.getContext().setExtensionPrompt('au_world_builder_injection','', -1, 0); } catch(_){}
        if(!s.customSections) s.customSections=[];
        if(!s.sectionConfig) s.sectionConfig={};
        ['world','charSetting','userSetting','charClothing','userClothing','genre'].forEach(function(k){
            if(!s.sectionConfig[k]) s.sectionConfig[k]=newSectionCfg();
        });
    }

    function saveSettings() {
        try { var ctx=SillyTavern.getContext(); if(ctx&&ctx.saveSettingsDebounced){ctx.saveSettingsDebounced();return;} } catch(_){}
        if(typeof saveSettingsDebounced==='function') saveSettingsDebounced();
    }

    var chatSpecificKeys = ['worldSetting','characterSettings','clothingStyles','genrePrompt','auConcept','history','customSectionData'];

    function getCurrentChatId() {
        try {
            var ctx=SillyTavern.getContext();
            if(ctx.chatId) return ctx.chatId;
            if(ctx.chat_metadata&&ctx.chat_metadata.chat_id) return ctx.chat_metadata.chat_id;
            if(ctx.characters&&ctx.characterId!=null) return (ctx.characters[ctx.characterId]?.name||'unk')+'_'+(ctx.chatId||'def');
        } catch(_){} return null;
    }
    function getChatData() { var id=getCurrentChatId(); if(!id) return {}; var s=getSettings(); return (s.chatData&&s.chatData[id])||{}; }
    function saveChatData(key,value) {
        var id=getCurrentChatId(); if(!id) return;
        var s=getSettings(); if(!s.chatData)s.chatData={}; if(!s.chatData[id])s.chatData[id]={};
        s.chatData[id][key]=value; saveSettings();
    }
    function saveSetting(key,value) {
        if(chatSpecificKeys.indexOf(key)!==-1) saveChatData(key,value);
        else { getSettings()[key]=value; saveSettings(); }
        updateExtensionPrompt();
    }
    function setVal(id,v)        { var el=document.getElementById(id); if(el) el.value=v; }
    function getElVal(id)        { var el=document.getElementById(id); return el?el.value:''; }
    function setChecked(id,v)    { var el=document.getElementById(id); if(el) el.checked=!!v; }
    function setSelectVal(id,v)  { var el=document.getElementById(id); if(el) el.value=v; }

    /* ================================================================
       SECTION 4 — SECTION MANAGEMENT  (D + J)
       ================================================================ */
    function getAllSections() {
        var s=getSettings(), ci=getCharacterInfo(), out=[];
        BUILTIN_SECTIONS.forEach(function(bs){
            var cfg=(s.sectionConfig&&s.sectionConfig[bs.id])||newSectionCfg();
            out.push({
                id:bs.id, tag:bs.tag, isBuiltIn:true,
                label:    bs.label.replace('{{char}}',ci.charName).replace('{{user}}',ci.userName),
                injHeader:bs.injHeader.replace('{{char}}',ci.charName).replace('{{user}}',ci.userName),
                enabled:cfg.enabled!==false,
                injPos:cfg.injPos!=null?cfg.injPos:1, injDepth:cfg.injDepth!=null?cfg.injDepth:4, injRole:cfg.injRole!=null?cfg.injRole:0,
            });
        });
        (s.customSections||[]).forEach(function(cs){
            out.push({
                id:cs.id, tag:'CUSTOM_'+cs.id.replace('custom_',''), isBuiltIn:false,
                label:cs.label, injHeader:'AU '+cs.label,
                enabled:cs.enabled!==false,
                injPos:cs.injPos!=null?cs.injPos:1, injDepth:cs.injDepth!=null?cs.injDepth:4, injRole:cs.injRole!=null?cs.injRole:0,
            });
        });
        return out;
    }
    function getEnabledSections() { return getAllSections().filter(function(s){return s.enabled;}); }

    function getSectionContent(sid) {
        var cd=getChatData();
        switch(sid){
            case 'world':        return cd.worldSetting||'';
            case 'charSetting':  return (cd.characterSettings&&cd.characterSettings.char)||'';
            case 'userSetting':  return (cd.characterSettings&&cd.characterSettings.user)||'';
            case 'charClothing': return (cd.clothingStyles&&cd.clothingStyles.char)||'';
            case 'userClothing': return (cd.clothingStyles&&cd.clothingStyles.user)||'';
            default:             return (cd.customSectionData&&cd.customSectionData[sid])||'';
        }
    }
    function setSectionContent(sid,val) {
        var cd=getChatData();
        switch(sid){
            case 'world':        saveChatData('worldSetting',val); break;
            case 'charSetting':  { var o=cd.characterSettings||{char:'',user:''}; o.char=val; saveChatData('characterSettings',o); break; }
            case 'userSetting':  { var o=cd.characterSettings||{char:'',user:''}; o.user=val; saveChatData('characterSettings',o); break; }
            case 'charClothing': { var o=cd.clothingStyles||{char:'',user:''}; o.char=val; saveChatData('clothingStyles',o); break; }
            case 'userClothing': { var o=cd.clothingStyles||{char:'',user:''}; o.user=val; saveChatData('clothingStyles',o); break; }
            default: { var csd=cd.customSectionData||{}; csd[sid]=val; saveChatData('customSectionData',csd); break; }
        }
    }

    var _biTextareaMap = {world:'auwb-world-setting-content',charSetting:'auwb-char-setting-content',
        userSetting:'auwb-user-setting-content',charClothing:'auwb-char-style-content',userClothing:'auwb-user-style-content'};
    function getSectionTextareaValue(sid) {
        if(_biTextareaMap[sid]) return getElVal(_biTextareaMap[sid]);
        var el=document.querySelector('[data-custom-section-id="'+sid+'"]'); return el?el.value:'';
    }
    function setSectionTextareaValue(sid,val) {
        if(_biTextareaMap[sid]){setVal(_biTextareaMap[sid],val);return;}
        var el=document.querySelector('[data-custom-section-id="'+sid+'"]'); if(el) el.value=val;
    }

    function addCustomSection(label) {
        var s=getSettings(), id='custom_'+Date.now()+'_'+Math.random().toString(36).substr(2,4);
        var sec={id:id,label:label.trim(),enabled:true,injPos:1,injDepth:4,injRole:0};
        s.customSections.push(sec); saveSettings(); return sec;
    }
    function removeCustomSection(sid) {
        var s=getSettings();
        s.customSections=(s.customSections||[]).filter(function(c){return c.id!==sid;});
        saveSettings();
        var cd=getChatData(); if(cd.customSectionData&&cd.customSectionData[sid]){delete cd.customSectionData[sid]; saveChatData('customSectionData',cd.customSectionData);}
        try{SillyTavern.getContext().setExtensionPrompt(MODULE_PREFIX+sid,'',-1,0);}catch(_){}
    }
    function updateSectionConfig(sid,key,value) {
        var s=getSettings();
        if(s.sectionConfig[sid]){s.sectionConfig[sid][key]=value;}
        else { var cs=(s.customSections||[]).find(function(c){return c.id===sid;}); if(cs)cs[key]=value; }
        saveSettings(); updateExtensionPrompt();
    }
    function isSectionEnabled(sid) {
        var s=getSettings();
        if(s.sectionConfig[sid]) return s.sectionConfig[sid].enabled!==false;
        var cs=(s.customSections||[]).find(function(c){return c.id===sid;});
        return cs?cs.enabled!==false:true;
    }

    /* ================================================================
       SECTION 5 — CHARACTER & CHAT INFO
       ================================================================ */
    function getCharacterInfo() {
        try {
            var ctx=SillyTavern.getContext();
            var cn=ctx.name2||'{{char}}', un=ctx.name1||'{{user}}';
            var desc='',pers='',scen='',persona='';
            if(ctx.getCharacterCardFields){var f=ctx.getCharacterCardFields();desc=f.description||'';pers=f.personality||'';scen=f.scenario||'';persona=f.persona||'';}
            if(!desc&&ctx.characters&&ctx.characterId!=null){var c=ctx.characters[ctx.characterId];if(c){desc=c.description||'';pers=c.personality||'';scen=c.scenario||'';cn=c.name||cn;}}
            return {charName:cn,userName:un,charDescription:desc,charPersonality:pers,charScenario:scen,personaDescription:persona};
        } catch(_){}
        return {charName:'{{char}}',userName:'{{user}}',charDescription:'',charPersonality:'',charScenario:'',personaDescription:''};
    }

    function getChatMessages(startIdx,endIdx) {
        try {
            var ctx=SillyTavern.getContext(); if(!ctx.chat||!Array.isArray(ctx.chat)) return '';
            var s=Math.max(0,startIdx),e=Math.min(ctx.chat.length-1,endIdx),msgs=[];
            for(var i=s;i<=e;i++){var m=ctx.chat[i];if(m&&m.mes)msgs.push((m.is_user?(ctx.name1||'User'):(ctx.name2||'Character'))+': '+m.mes);}
            return msgs.join('\n\n');
        } catch(_){} return '';
    }
    function getChatLength() { try{return SillyTavern.getContext().chat.length;}catch(_){return 0;} }

    /** Full snapshot of every section + genre */
    function getFullSnapshot() {
        var snap={};
        getAllSections().forEach(function(sec){ snap[sec.id]=getSectionTextareaValue(sec.id)||getSectionContent(sec.id); });
        snap.genrePrompt = getElVal('auwb-genre-prompt')||getChatData().genrePrompt||'';
        return snap;
    }

    /* ================================================================
       SECTION 6 — CONNECTION PROFILES
       ================================================================ */
    function getConnectionProfiles(){try{var ctx=SillyTavern.getContext();var cm=ctx.extensionSettings&&ctx.extensionSettings.connectionManager;return cm?cm.profiles||[]:[];}catch(_){return[];}}
    function getCurrentProfileName(){try{var ctx=SillyTavern.getContext(),cm=ctx.extensionSettings&&ctx.extensionSettings.connectionManager;if(cm&&cm.selectedProfile){var p=cm.profiles.find(function(x){return x.id===cm.selectedProfile;});return p?p.name:null;}}catch(_){}return null;}
    function getProfileNameById(id){try{var ctx=SillyTavern.getContext(),cm=ctx.extensionSettings&&ctx.extensionSettings.connectionManager;if(cm){var p=cm.profiles.find(function(x){return x.id===id;});return p?p.name:null;}}catch(_){}return null;}
    async function switchToProfile(name){if(!name)return false;try{var ctx=SillyTavern.getContext(),fn=ctx.executeSlashCommandsWithOptions||ctx.executeSlashCommands;if(fn){await fn('/profile '+name);await new Promise(function(r){setTimeout(r,1500);});return true;}}catch(_){}return false;}

    /* ================================================================
       SECTION 7 — API WITH RETRY
       ================================================================ */
    async function callAPI(prompt) {
        var settings=getSettings(), selectedId=settings.connectionProfile, originalProfile=null, switched=false;
        try {
            if(selectedId){var t=getProfileNameById(selectedId);if(t){originalProfile=getCurrentProfileName();if(originalProfile!==t)switched=await switchToProfile(t);}}
            var result='',ctx=SillyTavern.getContext();
            if(ctx.generateRaw) result=await ctx.generateRaw({prompt:prompt,maxContext:null,quietToLoud:false,skipWIAN:true,skipAN:true});
            else if(ctx.generateQuietPrompt) result=await ctx.generateQuietPrompt(prompt,false,false);
            if(!result&&typeof generateQuietPrompt==='function') result=await generateQuietPrompt(prompt,false,false);
            if(!result) throw new Error('No API function available or empty result');
            return result;
        } finally { if(switched&&originalProfile) await switchToProfile(originalProfile); }
    }
    async function callAPIWithRetry(prompt,retries) {
        if(retries===undefined) retries=MAX_RETRIES; var last;
        for(var a=0;a<retries;a++){
            try{return await callAPI(prompt);}catch(e){last=e;
                if(a<retries-1){var d=RETRY_BASE_MS*Math.pow(2,a);log('Retry '+(a+1)+'/'+retries+' in '+d+'ms');showStatus('API 재시도 중 ('+(a+1)+'/'+retries+')…','info');await new Promise(function(r){setTimeout(r,d);});}
            }
        } throw last;
    }
    async function testApiConnection(){var r=await callAPIWithRetry("Test connection. Reply with 'OK'.",1);if(r)return true;throw new Error('Empty');}

    /* ================================================================
       SECTION 8 — ROBUST PARSING  (+ custom tags)
       ================================================================ */
    function parseGeneratedContent(content) {
        if(!content) return {};
        var p=parseWithTags(content);  if(hasAny(p)) return p;
        p=parseWithMarkdown(content);  if(hasAny(p)) return p;
        p=parseWithSeparators(content);if(hasAny(p)) return p;
        log('Parsing: fallback → entire response as world');
        return {world:content.trim()};
    }
    function hasAny(p){ return !!(p.world||p.charSetting||p.userSetting); }

    function parseWithTags(c) {
        var p={},m;
        m=c.match(/\[WORLD\]([\s\S]*?)\[\/WORLD\]/i);                 if(m) p.world=m[1].trim();
        m=c.match(/\[CHAR\]([\s\S]*?)\[\/CHAR\]/i);                   if(m) p.charSetting=m[1].trim();
        m=c.match(/\[USER\]([\s\S]*?)\[\/USER\]/i);                   if(m) p.userSetting=m[1].trim();
        m=c.match(/\[CHAR_CLOTHING\]([\s\S]*?)\[\/CHAR_CLOTHING\]/i); if(m) p.charClothing=m[1].trim();
        m=c.match(/\[USER_CLOTHING\]([\s\S]*?)\[\/USER_CLOTHING\]/i); if(m) p.userClothing=m[1].trim();
        // alt tags
        if(!p.world){m=c.match(/\[WORLD_SETTING\]([\s\S]*?)\[\/WORLD_SETTING\]/i);if(m)p.world=m[1].trim();}
        if(!p.charSetting){m=c.match(/\[CHARACTER_CHAR\]([\s\S]*?)(?=\[CHARACTER_USER\]|\[STYLE_|\[|$)/i);if(m)p.charSetting=m[1].trim();}
        if(!p.userSetting){m=c.match(/\[CHARACTER_USER\]([\s\S]*?)(?=\[STYLE_|\[|$)/i);if(m)p.userSetting=m[1].trim();}
        if(!p.charClothing){m=c.match(/\[STYLE_CHAR\]([\s\S]*?)(?=\[STYLE_USER\]|\[|$)/i);if(m)p.charClothing=m[1].trim();}
        if(!p.userClothing){m=c.match(/\[STYLE_USER\]([\s\S]*?)(?=\[|$)/i);if(m)p.userClothing=m[1].trim();}
        /* D — custom section tags */
        (getSettings().customSections||[]).forEach(function(cs){
            var tag='CUSTOM_'+cs.id.replace('custom_','');
            var re=new RegExp('\\['+tag+'\\]([\\s\\S]*?)\\[\\/'+tag+'\\]','i');
            var cm=c.match(re); if(cm) p[cs.id]=cm[1].trim();
        });
        return p;
    }

    function parseWithMarkdown(c) {
        var p={},ci=getCharacterInfo();
        var wm=c.match(/#+\s*(?:World\s*Setting|세계관\s*설정|World\s*Overview)([\s\S]*?)(?=#+\s*(?:Character|캐릭터)|$)/i);
        if(wm) p.world=cleanSection(wm[1]);
        var charRe=new RegExp('#+\\s*(?:'+escapeRegex(ci.charName)+'|\\{\\{char\\}\\})(?:\\s*(?:설정|Setting|Profile))?([\\s\\S]*?)(?=#+|$)','i');
        var cm=c.match(charRe); if(cm) p.charSetting=cleanSection(cm[1]);
        var userRe=new RegExp('#+\\s*(?:'+escapeRegex(ci.userName)+'|\\{\\{user\\}\\})(?:\\s*(?:설정|Setting|Profile))?([\\s\\S]*?)(?=#+|$)','i');
        var um=c.match(userRe); if(um) p.userSetting=cleanSection(um[1]);
        return p;
    }

    function parseWithSeparators(c) {
        var p={},secs=c.split(/---+/).map(function(s){return s.trim();}).filter(Boolean);
        if(secs.length>=2){p.world=cleanSection(secs[0]);p.charSetting=cleanSection(secs[1]);if(secs.length>=3)p.userSetting=cleanSection(secs[2]);if(secs.length>=4)p.charClothing=cleanSection(secs[3]);if(secs.length>=5)p.userClothing=cleanSection(secs[4]);}
        if(!hasAny(p)){var numbered=c.split(/\n(?=\d+\.\s)/).map(function(s){return s.replace(/^\d+\.\s*/,'').trim();}).filter(Boolean);
            if(numbered.length>=2){p.world=numbered[0];p.charSetting=numbered[1]||'';p.userSetting=numbered[2]||'';p.charClothing=numbered[3]||'';p.userClothing=numbered[4]||'';}}
        return p;
    }

    /* ================================================================
       SECTION 9 — HISTORY & DIFF   (C)
       ================================================================ */
    function getHistory() { return getChatData().history||[]; }
    function saveToHistory(type,snapshot) {
        var h=getChatData().history||[];
        h.unshift({id:Date.now()+'_'+Math.random().toString(36).substr(2,6),timestamp:Date.now(),type:type,snapshot:JSON.parse(JSON.stringify(snapshot))});
        if(h.length>MAX_HISTORY) h=h.slice(0,MAX_HISTORY);
        saveChatData('history',h);
    }
    function rollbackToVersion(hid) {
        var entry=getHistory().find(function(h){return h.id===hid;});
        if(!entry){showStatus('히스토리 항목을 찾을 수 없습니다.','error');return;}
        var snap=entry.snapshot;
        Object.keys(snap).forEach(function(k){
            if(k==='genrePrompt'){saveChatData('genrePrompt',snap[k]);return;}
            setSectionContent(k,snap[k]||'');
        });
        loadChatDataToUI(); updateExtensionPrompt(); showStatus('버전이 복원되었습니다!','success');
    }
    /** C — snapshot diff */
    function computeSnapshotDiff(before,after) {
        var diffs=[];
        getAllSections().forEach(function(sec){
            var o=before[sec.id]||'', n=after[sec.id]||'';
            if(o!==n) diffs.push({id:sec.id,label:sec.label,lines:diffLines(o,n)});
        });
        if((before.genrePrompt||'')!==(after.genrePrompt||''))
            diffs.push({id:'genre',label:'장르/톤',lines:diffLines(before.genrePrompt||'',after.genrePrompt||'')});
        return diffs;
    }

    /* ================================================================
       SECTION 10 — CONTENT GENERATION   (D-aware)
       ================================================================ */
    function getPromptTemplate(key) {
        var cp=getSettings().customPrompts||{}, v=cp[key];
        if(v&&v.trim()) return v;
        return {initial:DEFAULT_INITIAL_PROMPT,update:DEFAULT_UPDATE_PROMPT,genre:DEFAULT_GENRE_PROMPT,
                section:DEFAULT_SECTION_PROMPT,smartAnalysis:DEFAULT_SMART_ANALYSIS_PROMPT}[key]||'';
    }
    function buildGuidelines() {
        var s=getSettings(),opts=s.genOptions||{},ci=getCharacterInfo(),g=[];
        g.push(opts.cliche==='subvert'?'- SUBVERT CLICHES: Twist expectations.':'- CLICHES ALLOWED: Classic tropes are fine.');
        g.push(opts.original==='break'?'- BREAK FROM ORIGINAL: Completely reimagine characters.':'- REFLECT ORIGINAL: Preserve core traits.');
        g.push(opts.relation==='first'?'- FIRST MEETING: '+ci.charName+' and '+ci.userName+' are strangers.':'- ESTABLISHED CONNECTION: They already know each other.');
        g.push(opts.mood==='light'?'- LIGHT ATMOSPHERE: Bright, comedic, heartwarming.':'- DARK ATMOSPHERE: Serious, dramatic, intense.');
        g.push('- ADD DEPTH: Contradictions, hidden aspects, unexpected connections.');
        g.push('- SPECIFIC DETAILS: Concrete, vivid — avoid generic descriptions.');
        return g.join('\n');
    }
    function getLangInstruction() { return getSettings().outputLanguage==='korean'?'CRITICAL: Write ALL content in Korean (한국어). Be literary and evocative.':'CRITICAL: Write ALL content in English. Be literary and evocative.'; }
    function fillTemplate(tmpl,vars){ for(var k in vars) tmpl=tmpl.split('{{'+k+'}}').join(vars[k]||''); return tmpl; }

    /** D — dynamic OUTPUT_FORMAT based on enabled sections */
    function buildOutputFormat() {
        var ci=getCharacterInfo();
        return getEnabledSections().map(function(sec){
            var desc;
            switch(sec.id){
                case 'world':desc='(3 paragraphs: world rules / atmosphere & society / key locations & daily life)';break;
                case 'charSetting':desc='(2 paragraphs about '+ci.charName+': role & public persona / hidden depths & habits)';break;
                case 'userSetting':desc='(2 paragraphs about '+ci.userName+': independent role / connection to '+ci.charName+')';break;
                case 'charClothing':desc="(1 detailed paragraph: "+ci.charName+"'s signature look)";break;
                case 'userClothing':desc="(1 detailed paragraph: "+ci.userName+"'s attire)";break;
                default: desc='(Detailed content for: '+sec.label+')'; break;
            }
            return '['+sec.tag+']\n'+desc+'\n[/'+sec.tag+']';
        }).join('\n\n');
    }

    /** D — EXISTING_SETTINGS for all enabled sections */
    function buildExistingSettings() {
        var lines=[];
        getEnabledSections().forEach(function(sec){
            var c=getSectionContent(sec.id)||'(Not yet established)';
            lines.push('### '+sec.label+': '+c);
        });
        var genreCfg=(getSettings().sectionConfig||{}).genre||newSectionCfg();
        if(genreCfg.enabled!==false){var gp=getChatData().genrePrompt||'';if(gp)lines.push('### Genre/Tone: '+gp);}
        return lines.join('\n');
    }

    async function generateAUWorld(concept) {
        var ci=getCharacterInfo();
        return await callAPIWithRetry(fillTemplate(getPromptTemplate('initial'),{
            GUIDELINES:buildGuidelines(),CONCEPT:concept,
            CHAR_NAME:ci.charName,CHAR_DESC:ci.charDescription||'Not provided',
            CHAR_PERS:ci.charPersonality||'Not provided',CHAR_SCENE:ci.charScenario||'Not provided',
            USER_NAME:ci.userName,USER_PERSONA:ci.personaDescription||'Not provided',
            OUTPUT_FORMAT:buildOutputFormat(),LANG_INSTRUCTION:getLangInstruction(),EXISTING_SETTINGS:'',
        }));
    }

    /** D — check enabled before regeneration */
    async function regenerateSection(sectionKey) {
        if(!isSectionEnabled(sectionKey)) throw new Error('해당 섹션이 비활성화되어 있습니다.');
        var ci=getCharacterInfo(), sec=getAllSections().find(function(s){return s.id===sectionKey;});
        if(!sec) throw new Error('Unknown section: '+sectionKey);
        var cd=getChatData(),tagPart='['+sec.tag+']\n(Detailed content for: '+sec.label+')\n[/'+sec.tag+']';
        var result=await callAPIWithRetry(fillTemplate(getPromptTemplate('section'),{
            SECTION_LABEL:sec.label,CONCEPT:cd.auConcept||'',
            CHAR_NAME:ci.charName,CHAR_DESC:ci.charDescription||'',USER_NAME:ci.userName,USER_PERSONA:ci.personaDescription||'',
            EXISTING_SETTINGS:buildExistingSettings(),SECTION_TAG:tagPart,LANG_INSTRUCTION:getLangInstruction(),
        }));
        if(!result) throw new Error('Empty response');
        var parsed=parseGeneratedContent(result);
        return {section:sectionKey,value:parsed[sectionKey]||result.replace(/\[.*?\]/g,'').trim()};
    }

    /* ================================================================
       SECTION 11 — UPDATE SYSTEM   (D-aware + C-diff)
       ================================================================ */
    var autoUpdateMessageCount=0, isAutoUpdating=false;

    async function updateFromRange(startIdx,endIdx) {
        var chat=getChatMessages(startIdx,endIdx);if(!chat)throw new Error('No messages in range.');
        var ci=getCharacterInfo();
        return await callAPIWithRetry(fillTemplate(getPromptTemplate('update'),{
            CHAR_NAME:ci.charName,USER_NAME:ci.userName,
            EXISTING_SETTINGS:buildExistingSettings(),START:String(startIdx),END:String(endIdx),MESSAGES:chat,
            OUTPUT_FORMAT:buildOutputFormat(),LANG_INSTRUCTION:getLangInstruction(),
            /* compat for old custom prompts */
            CURRENT_WORLD:getSectionContent('world')||'(Not yet)',CURRENT_CHAR:getSectionContent('charSetting')||'(Not yet)',
            CURRENT_USER:getSectionContent('userSetting')||'(Not yet)',CURRENT_CHAR_CLOTHING:getSectionContent('charClothing')||'(Not yet)',
            CURRENT_USER_CLOTHING:getSectionContent('userClothing')||'(Not yet)',
        }));
    }

    async function shouldUpdate(startIdx,endIdx) {
        var s=getSettings();if(!s.smartAutoUpdate)return true;
        try{
            var chat=getChatMessages(startIdx,endIdx);if(!chat)return false;
            var summary=buildExistingSettings().substring(0,500);
            var res=await callAPIWithRetry(fillTemplate(getPromptTemplate('smartAnalysis'),{
                WORLD_SUMMARY:summary||'(no world yet)',START:String(startIdx),END:String(endIdx),MESSAGES:chat,
            }),1);
            if(res&&res.toUpperCase().indexOf('NO_UPDATE_NEEDED')!==-1){log('Smart: no update');return false;}
            return true;
        }catch(e){log('Smart analysis failed: '+e.message);return true;}
    }

    async function triggerAutoUpdate(messageCount) {
        if(isAutoUpdating)return;isAutoUpdating=true;
        try{
            var total=getChatLength();if(!total)return;
            var s0=Math.max(0,total-messageCount),e0=total-1;
            if(!(await shouldUpdate(s0,e0))){showStatus('스마트 분석: 업데이트 불필요','info');return;}
            var result=await updateFromRange(s0,e0);
            if(result){applyUpdateResult(result,'auto-update');showStatus('자동 업데이트 완료!','success');}
        }catch(e){logError('Auto-update failed',e);}finally{isAutoUpdating=false;}
    }

    function applyUpdateResult(result,type) {
        var before=getFullSnapshot();
        saveToHistory(type||'update',before);
        var parsed=parseGeneratedContent(result);
        var enabledIds=getEnabledSections().map(function(s){return s.id;});
        Object.keys(parsed).forEach(function(k){
            if(enabledIds.indexOf(k)===-1) return;
            if(!parsed[k]) return;
            setSectionContent(k,parsed[k]);
            setSectionTextareaValue(k,parsed[k]);
        });
        updateExtensionPrompt(); updateTokenDisplay(); renderHistoryList();
        /* C — diff notification */
        var after=getFullSnapshot(), diffs=computeSnapshotDiff(before,after);
        if(diffs.length) showStatus('업데이트 완료! 변경: '+diffs.map(function(d){return d.label;}).join(', '),'success');
    }

    /* ================================================================
       SECTION 12 — GENRE PROMPT
       ================================================================ */
    async function generateGenrePromptText() {
        var w=getSectionContent('world');if(!w) throw new Error('세계관 설정을 먼저 생성해주세요.');
        return await callAPIWithRetry(fillTemplate(getPromptTemplate('genre'),{WORLD_SETTING:w,LANG_INSTRUCTION:getLangInstruction()}));
    }

    /* ================================================================
       SECTION 13 — CUSTOM PROMPTS UI
       ================================================================ */
    function loadCustomPromptsToUI(){var cp=getSettings().customPrompts||{};setVal('auwb-custom-initial-prompt',cp.initial||'');setVal('auwb-custom-update-prompt',cp.update||'');setVal('auwb-custom-genre-prompt',cp.genre||'');setVal('auwb-custom-section-prompt',cp.section||'');setVal('auwb-custom-analysis-prompt',cp.smartAnalysis||'');}
    function saveCustomPrompts(){var s=getSettings();s.customPrompts={initial:getElVal('auwb-custom-initial-prompt'),update:getElVal('auwb-custom-update-prompt'),genre:getElVal('auwb-custom-genre-prompt'),section:getElVal('auwb-custom-section-prompt'),smartAnalysis:getElVal('auwb-custom-analysis-prompt')};saveSettings();showStatus('프롬프트 저장됨!','success');}
    function resetPromptTemplate(key){var dMap={initial:DEFAULT_INITIAL_PROMPT,update:DEFAULT_UPDATE_PROMPT,genre:DEFAULT_GENRE_PROMPT,section:DEFAULT_SECTION_PROMPT,smartAnalysis:DEFAULT_SMART_ANALYSIS_PROMPT};var iMap={initial:'auwb-custom-initial-prompt',update:'auwb-custom-update-prompt',genre:'auwb-custom-genre-prompt',section:'auwb-custom-section-prompt',smartAnalysis:'auwb-custom-analysis-prompt'};setVal(iMap[key],dMap[key]||'');var s=getSettings();if(s.customPrompts)s.customPrompts[key]='';saveSettings();showStatus('기본 템플릿으로 초기화됨','success');}

    /* ================================================================
       SECTION 14 — INJECTION SYSTEM   (J — per-section)
       ================================================================ */
    function updateExtensionPrompt() {
        try {
            var ctx=SillyTavern.getContext();if(!ctx||typeof ctx.setExtensionPrompt!=='function')return;
            var s=getSettings();
            getAllSections().forEach(function(sec){
                var mid=MODULE_PREFIX+sec.id, c=getSectionContent(sec.id);
                if(s.enabled && sec.enabled && c && c.trim()){
                    ctx.setExtensionPrompt(mid,'['+sec.injHeader+']\n'+c.trim(),sec.injPos,sec.injDepth,true,sec.injRole);
                }else{
                    ctx.setExtensionPrompt(mid,'',-1,0);
                }
            });
            /* genre */
            var gc=(s.sectionConfig&&s.sectionConfig.genre)||newSectionCfg();
            var gp=getChatData().genrePrompt||'';
            if(s.enabled && gc.enabled!==false && s.genrePromptEnabled && gp.trim()){
                ctx.setExtensionPrompt(MODULE_PREFIX+'genre','[Genre/Tone Instructions]\n'+gp.trim(),gc.injPos!=null?gc.injPos:1,gc.injDepth!=null?gc.injDepth:4,true,gc.injRole||0);
            }else{
                ctx.setExtensionPrompt(MODULE_PREFIX+'genre','',-1,0);
            }
        }catch(e){logError('updateExtensionPrompt',e);}
    }

    function getInjectionTokenInfo() {
        var total=0,s=getSettings();
        getAllSections().forEach(function(sec){
            if(s.enabled&&sec.enabled){var c=getSectionContent(sec.id);if(c)total+=estimateTokens('['+sec.injHeader+']\n'+c.trim());}
        });
        var gc=(s.sectionConfig&&s.sectionConfig.genre)||newSectionCfg();
        if(s.enabled&&gc.enabled!==false&&s.genrePromptEnabled){var gp=getChatData().genrePrompt||'';if(gp)total+=estimateTokens('[Genre/Tone Instructions]\n'+gp.trim());}
        return {tokens:total};
    }

    function getInjectionPreview() {
        var s=getSettings(),lines=['=== AU World Builder 주입 미리보기 ===\n'];
        getAllSections().forEach(function(sec){
            var c=getSectionContent(sec.id),st=!sec.enabled?' [비활성화]':(!c?' [빈 섹션]':'');
            if(c&&sec.enabled) lines.push('--- '+sec.label+' (pos='+sec.injPos+' depth='+sec.injDepth+' role='+['Sys','Usr','Asst'][sec.injRole]+') ---\n'+c+'\n');
            else lines.push('--- '+sec.label+st+' ---\n');
        });
        var gc=(s.sectionConfig&&s.sectionConfig.genre)||newSectionCfg();
        if(s.genrePromptEnabled&&gc.enabled!==false){var gp=getChatData().genrePrompt;if(gp)lines.push('--- 장르/톤 ---\n'+gp+'\n');}
        lines.push('\n--- 예상 토큰 수: ~'+getInjectionTokenInfo().tokens+' tokens ---');
        return lines.join('\n');
    }

    /* ================================================================
       SECTION 15 — LOREBOOK / WORLD INFO EXPORT
       ================================================================ */
    function exportToLorebook(){
        var ci=getCharacterInfo(),cd=getChatData(),entries={},uid=0;
        function add(kw,cmt,ct){if(!ct||!ct.trim())return;entries[uid]={uid:uid,key:kw,keysecondary:[],comment:cmt,content:ct.trim(),constant:false,selective:false,selectiveLogic:0,addMemo:true,order:100+uid,position:0,disable:false,excludeRecursion:false,preventRecursion:false,delayUntilRecursion:false,probability:100,useProbability:true,depth:4,group:'AU World Builder',groupOverride:false,groupWeight:100,scanDepth:null,caseSensitive:false,matchWholeWords:false,automationId:'',role:null,sticky:null,cooldown:null,delay:null};uid++;}
        getAllSections().forEach(function(sec){add([sec.label.toLowerCase(),'au'],'AU: '+sec.label,getSectionContent(sec.id));});
        var gp=cd.genrePrompt;if(gp)add(['au genre','au tone'],'AU Genre/Tone',gp);
        var blob=new Blob([JSON.stringify({entries:entries},null,2)],{type:'application/json'});
        var url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='AU-WorldInfo-'+(ci.charName||'export')+'-'+Date.now()+'.json';
        document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);showStatus('Lorebook JSON 내보내기 완료!','success');
    }
    async function exportToLorebookDirect(){
        try{var ctx=SillyTavern.getContext(),exec=ctx.executeSlashCommandsWithOptions||ctx.executeSlashCommands;if(!exec)throw 0;var n=0;for(var sec of getEnabledSections()){var c=getSectionContent(sec.id);if(!c)continue;await exec('/wi create key="'+sec.label.toLowerCase()+', au" '+c.replace(/\n/g,' ').substring(0,2000));n++;}showStatus(n+'개 WI 항목 생성!','success');}
        catch(_){exportToLorebook();}
    }

    /* ================================================================
       SECTION 16 — PRESET MANAGEMENT
       ================================================================ */
    function pid(){return 'preset_'+Date.now()+'_'+Math.random().toString(36).substr(2,9);}
    function getPresets(){return getSettings().presets||[];}
    function savePreset(name){if(!name||!name.trim())throw new Error('Name required');var d=getFullSnapshot(),ci=getCharacterInfo(),p={id:pid(),name:name.trim(),createdAt:new Date().toISOString(),updatedAt:new Date().toISOString(),characterName:ci.charName,data:d};var s=getSettings();if(!s.presets)s.presets=[];s.presets.push(p);saveSettings();return p;}
    function loadPreset(presetId){var p=getPresets().find(function(x){return x.id===presetId;});if(!p)throw new Error('Not found');saveToHistory('preset-load',getFullSnapshot());var d=p.data;Object.keys(d).forEach(function(k){if(k==='genrePrompt'){saveChatData('genrePrompt',d[k]||'');return;}setSectionContent(k,d[k]||'');});loadChatDataToUI();return p;}
    function renamePreset(pid,n){var s=getSettings();var p=s.presets.find(function(x){return x.id===pid;});if(!p)throw new Error('Not found');p.name=n.trim();p.updatedAt=new Date().toISOString();saveSettings();}
    function deletePreset(pid){var s=getSettings(),i=s.presets.findIndex(function(x){return x.id===pid;});if(i===-1)throw new Error('Not found');s.presets.splice(i,1);saveSettings();}
    function exportPresets(){var d={version:'1.0',exportDate:new Date().toISOString(),type:'au-world-builder-presets',presets:getPresets()};var b=new Blob([JSON.stringify(d,null,2)],{type:'application/json'});var u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='au-wb-presets-'+Date.now()+'.json';document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(u);}
    function importPresets(fc){var d=JSON.parse(fc);if(d.type!=='au-world-builder-presets'||!Array.isArray(d.presets))throw new Error('Invalid');var s=getSettings();if(!s.presets)s.presets=[];var c=0;d.presets.forEach(function(p){p.id=pid();p.name=p.name+' (imported)';s.presets.push(p);c++;});saveSettings();return c;}

    /* ================================================================
       SECTION 17 — CHATDATA CLEANUP  (H)
       ================================================================ */
    function getChatDataStats(){var s=getSettings(),d=s.chatData||{},keys=Object.keys(d);return{totalEntries:keys.length,currentChatId:getCurrentChatId(),sizeBytes:JSON.stringify(d).length,keys:keys};}
    function cleanupChatData(keepCurrent){var s=getSettings();if(!s.chatData)return 0;var cid=getCurrentChatId(),keys=Object.keys(s.chatData),rm=0;keys.forEach(function(k){if(keepCurrent&&k===cid)return;delete s.chatData[k];rm++;});saveSettings();return rm;}

    /* ================================================================
       SECTION 18 — UI MANAGEMENT
       ================================================================ */
    function showStatus(msg,type){
        var el=document.getElementById('auwb-status-message');
        if(el){el.textContent=msg;el.className='auwb-status-message '+type;el.style.display='block';if(type!=='error')setTimeout(function(){el.style.display='none';},5000);}
        try{if(typeof toastr!=='undefined'){if(type==='error')toastr.error(msg);else if(type==='success')toastr.success(msg);else toastr.info(msg);}}catch(_){}
    }

    function updateCharacterNames(){
        var ci=getCharacterInfo();
        document.querySelectorAll('.auwb-char-name').forEach(function(el){el.textContent=ci.charName;});
        document.querySelectorAll('.auwb-user-name').forEach(function(el){el.textContent=ci.userName;});
        try{var len=getChatLength();var le=document.getElementById('auwb-chat-length');if(le)le.textContent=String(len);var ei=document.getElementById('auwb-update-end');if(ei&&len>0)ei.value=String(len-1);}catch(_){}
    }

    function loadChatDataToUI(){
        setVal('auwb-au-concept',getChatData().auConcept||'');
        BUILTIN_SECTIONS.forEach(function(bs){if(_biTextareaMap[bs.id])setVal(_biTextareaMap[bs.id],getSectionContent(bs.id));});
        setVal('auwb-genre-prompt',getChatData().genrePrompt||'');
        updateExtensionPrompt(); renderHistoryList(); renderCustomSectionContent(); updateSectionDisabledVisuals();
    }

    function loadSettingsToUI(){
        var s=getSettings(); loadChatDataToUI();
        setChecked('auwb-enabled',s.enabled);
        setChecked('auwb-auto-update',s.autoUpdateEnabled);
        setChecked('auwb-smart-auto-update',s.smartAutoUpdate!==false);
        setChecked('auwb-genre-enabled',s.genrePromptEnabled);
        setChecked('auwb-debug-mode',s.debugMode);
        setVal('auwb-update-interval',s.autoUpdateInterval||5);
        setSelectVal('auwb-api-source',s.apiSource||'sillytavern');
        setSelectVal('auwb-output-language',s.outputLanguage||'korean');
        setVal('auwb-api-url',s.customApiUrl||'');
        setVal('auwb-api-key',s.customApiKey||'');
        setVal('auwb-api-model',s.customApiModel||'');
        setVal('auwb-api-max-tokens',s.customApiMaxTokens||4000);
        setVal('auwb-api-timeout',s.customApiTimeout||120);
        updateApiSettingsVisibility(); populateConnectionProfiles(); updateCharacterNames();
        loadCustomPromptsToUI(); updateTokenDisplay(); renderSectionManager(); renderCustomSectionContent(); updateDataStats();
    }

    function updateApiSettingsVisibility(){var src=getElVal('auwb-api-source'),st=document.getElementById('auwb-st-api-settings'),cu=document.getElementById('auwb-custom-api-settings');if(st)st.style.display=src==='sillytavern'?'block':'none';if(cu)cu.style.display=src!=='sillytavern'?'block':'none';}
    function populateConnectionProfiles(){var sel=document.getElementById('auwb-connection-profile');if(!sel)return;var ps=getConnectionProfiles();sel.innerHTML='<option value="">현재 API 연결 사용</option>';ps.forEach(function(p){var o=document.createElement('option');o.value=p.id;o.textContent=p.name||p.id;sel.appendChild(o);});var s=getSettings();if(s.connectionProfile)sel.value=s.connectionProfile;}
    async function checkApiStatus(){var el=document.getElementById('auwb-api-status');if(!el)return;el.innerHTML='<span class="auwb-status-indicator checking"></span><span>확인 중…</span>';try{var ctx=SillyTavern.getContext();var ok=!!(ctx.generateRaw||ctx.generateQuietPrompt);el.innerHTML=ok?'<span class="auwb-status-indicator connected"></span><span>Connected</span>':'<span class="auwb-status-indicator disconnected"></span><span>No API</span>';}catch(_){el.innerHTML='<span class="auwb-status-indicator disconnected"></span><span>Error</span>';}}
    function updateTokenDisplay(){var el=document.getElementById('auwb-token-display');if(el)el.textContent='~'+getInjectionTokenInfo().tokens+' tokens';}

    /* D+J — Section Manager -------------------------------------------- */
    function renderSectionManager(){
        var container=document.getElementById('auwb-section-manager');if(!container)return;
        var s=getSettings(), items=[];
        getAllSections().forEach(function(sec){items.push({id:sec.id,label:sec.label,isBuiltIn:sec.isBuiltIn,enabled:sec.enabled,injPos:sec.injPos,injDepth:sec.injDepth,injRole:sec.injRole});});
        var gc=(s.sectionConfig&&s.sectionConfig.genre)||newSectionCfg();
        items.push({id:'genre',label:'장르/톤',isBuiltIn:true,enabled:gc.enabled!==false,injPos:gc.injPos!=null?gc.injPos:1,injDepth:gc.injDepth!=null?gc.injDepth:4,injRole:gc.injRole||0});

        var html='';
        items.forEach(function(it){
            html+='<div class="auwb-secmgr-item" data-sec-id="'+it.id+'">'
                +'<div class="auwb-secmgr-header">'
                +'<label class="auwb-toggle auwb-toggle-sm"><input type="checkbox" class="auwb-secmgr-toggle" '+(it.enabled?'checked':'')+'><span class="auwb-toggle-slider"></span></label>'
                +'<span class="auwb-secmgr-label">'+escapeHtml(it.label)+'</span>';
            if(!it.isBuiltIn) html+='<button class="auwb-preset-btn delete auwb-secmgr-delete" title="삭제"><i class="fa-solid fa-trash"></i></button>';
            html+='<button class="auwb-secmgr-expand auwb-preset-btn" title="주입 설정"><i class="fa-solid fa-chevron-down"></i></button>'
                +'</div>'
                +'<div class="auwb-secmgr-body" style="display:none;">'
                +'<div class="auwb-input-row">'
                +'<div class="auwb-input-group auwb-third"><label>위치</label><select class="auwb-select auwb-secmgr-pos">'
                    +'<option value="0"'+(it.injPos===0?' selected':'')+'>Before Main</option>'
                    +'<option value="1"'+(it.injPos===1?' selected':'')+'>In-Chat</option>'
                    +'<option value="2"'+(it.injPos===2?' selected':'')+'>After Main</option></select></div>'
                +'<div class="auwb-input-group auwb-third"><label>Depth</label><input type="number" class="auwb-input auwb-secmgr-depth" value="'+it.injDepth+'" min="0" max="999"></div>'
                +'<div class="auwb-input-group auwb-third"><label>Role</label><select class="auwb-select auwb-secmgr-role">'
                    +'<option value="0"'+(it.injRole===0?' selected':'')+'>System</option>'
                    +'<option value="1"'+(it.injRole===1?' selected':'')+'>User</option>'
                    +'<option value="2"'+(it.injRole===2?' selected':'')+'>Assistant</option></select></div>'
                +'</div></div></div>';
        });
        container.innerHTML=html;

        container.querySelectorAll('.auwb-secmgr-item').forEach(function(el){
            var sid=el.getAttribute('data-sec-id');
            el.querySelector('.auwb-secmgr-toggle').addEventListener('change',function(){updateSectionConfig(sid,'enabled',this.checked);updateTokenDisplay();renderCustomSectionContent();updateSectionDisabledVisuals();});
            el.querySelector('.auwb-secmgr-expand').addEventListener('click',function(){var b=el.querySelector('.auwb-secmgr-body'),ic=this.querySelector('i');if(b.style.display==='none'){b.style.display='block';ic.className='fa-solid fa-chevron-up';}else{b.style.display='none';ic.className='fa-solid fa-chevron-down';}});
            var pos=el.querySelector('.auwb-secmgr-pos');if(pos)pos.addEventListener('change',function(){updateSectionConfig(sid,'injPos',parseInt(this.value));});
            var dep=el.querySelector('.auwb-secmgr-depth');if(dep)dep.addEventListener('change',function(){updateSectionConfig(sid,'injDepth',parseInt(this.value)||4);});
            var rol=el.querySelector('.auwb-secmgr-role');if(rol)rol.addEventListener('change',function(){updateSectionConfig(sid,'injRole',parseInt(this.value));});
            var del=el.querySelector('.auwb-secmgr-delete');
            if(del)del.addEventListener('click',function(){if(!confirm('커스텀 섹션 "'+el.querySelector('.auwb-secmgr-label').textContent+'"을(를) 삭제하시겠습니까?'))return;removeCustomSection(sid);renderSectionManager();renderCustomSectionContent();updateExtensionPrompt();showStatus('섹션 삭제됨','success');});
        });
    }

    function updateSectionDisabledVisuals(){
        BUILTIN_SECTIONS.forEach(function(bs){
            var el=document.getElementById(_biTextareaMap[bs.id]);if(!el)return;
            var sec=el.closest('.auwb-section');if(!sec)return;
            if(!isSectionEnabled(bs.id))sec.classList.add('auwb-section-disabled');else sec.classList.remove('auwb-section-disabled');
        });
    }

    /* D — Custom section content areas --------------------------------- */
    function renderCustomSectionContent(){
        var container=document.getElementById('auwb-custom-sections-content');if(!container)return;
        var customs=getSettings().customSections||[];
        if(!customs.length){container.innerHTML='';return;}
        var html='';
        customs.forEach(function(cs){
            var content=getSectionContent(cs.id), dis=cs.enabled===false;
            html+='<div class="auwb-section'+(dis?' auwb-section-disabled':'')+'">'
                +'<h4><i class="fa-solid fa-puzzle-piece"></i> '+escapeHtml(cs.label)+(dis?' <span class="auwb-disabled-badge">비활성화</span>':'')+'</h4>'
                +'<textarea class="auwb-textarea" rows="6" data-custom-section-id="'+cs.id+'" placeholder="'+escapeHtml(cs.label)+' 내용...">'+escapeHtml(content)+'</textarea>'
                +'<div class="auwb-btn-group">'
                +'<button class="auwb-btn auwb-btn-primary auwb-btn-sm auwb-save-csec" data-sid="'+cs.id+'"><i class="fa-solid fa-floppy-disk"></i> 저장</button>'
                +'<button class="auwb-btn auwb-btn-secondary auwb-btn-sm auwb-regen-csec" data-sid="'+cs.id+'"'+(dis?' disabled':'')+'><i class="fa-solid fa-rotate"></i> 재생성</button>'
                +'</div></div>';
        });
        container.innerHTML=html;
        container.querySelectorAll('.auwb-save-csec').forEach(function(btn){
            btn.addEventListener('click',function(){var sid=btn.getAttribute('data-sid'),ta=container.querySelector('[data-custom-section-id="'+sid+'"]');if(ta){setSectionContent(sid,ta.value);updateExtensionPrompt();updateTokenDisplay();showStatus('커스텀 섹션 저장됨!','success');}});
        });
        container.querySelectorAll('.auwb-regen-csec').forEach(function(btn){
            btn.addEventListener('click',function(){var sid=btn.getAttribute('data-sid');btnLoading(btn,async function(){showStatus('섹션 재생성 중…','info');saveToHistory('regen',getFullSnapshot());var res=await regenerateSection(sid);if(res&&res.value){setSectionContent(sid,res.value);var ta=container.querySelector('[data-custom-section-id="'+sid+'"]');if(ta)ta.value=res.value;updateExtensionPrompt();updateTokenDisplay();renderHistoryList();showStatus('재생성 완료!','success');}});});
        });
    }

    /* C — Diff View ----------------------------------------------------- */
    function showDiffView(before,after){
        var diffs=computeSnapshotDiff(before,after);
        var el=document.getElementById('auwb-diff-content');if(!el)return;
        if(!diffs.length){el.innerHTML='<p style="text-align:center;color:var(--auwb-text-muted);">변경 사항이 없습니다.</p>';}
        else{
            var html='';
            diffs.forEach(function(d){
                html+='<div class="auwb-diff-section"><h4>'+escapeHtml(d.label)+'</h4><div class="auwb-diff-lines">';
                d.lines.forEach(function(l){
                    var cls=l.type==='added'?'auwb-diff-added':l.type==='removed'?'auwb-diff-removed':'auwb-diff-same';
                    html+='<div class="'+cls+'">'+(l.type==='added'?'+ ':l.type==='removed'?'- ':'  ')+escapeHtml(l.text)+'</div>';
                });
                html+='</div></div>';
            });
            el.innerHTML=html;
        }
        var modal=document.getElementById('auwb-diff-modal');if(modal)modal.style.display='flex';
    }

    /* H — Data stats ---------------------------------------------------- */
    function updateDataStats(){
        var el=document.getElementById('auwb-data-stats');if(!el)return;
        var st=getChatDataStats();
        el.innerHTML='<div class="auwb-api-status"><span>저장된 채팅 데이터: <strong>'+st.totalEntries+'</strong>개 (~'+(st.sizeBytes/1024).toFixed(1)+'KB)</span></div>';
    }

    /* History rendering (C — diff button) -------------------------------- */
    function renderHistoryList(){
        var el=document.getElementById('auwb-history-list');if(!el)return;
        var h=getHistory();
        if(!h.length){el.innerHTML='<div class="auwb-preset-empty">히스토리가 없습니다.</div>';return;}
        var typeMap={'initial':'초기 생성','auto-update':'자동 업데이트','manual-update':'수동 업데이트','regen':'섹션 재생성','preset-load':'프리셋 로드','update':'업데이트','before-rollback':'롤백 전','before-import':'가져오기 전','before-clear':'초기화 전'};
        var html='';
        h.forEach(function(e){
            html+='<div class="auwb-history-item" data-hid="'+e.id+'">'
                +'<div class="auwb-history-info"><span class="auwb-history-type">'+escapeHtml(typeMap[e.type]||e.type)+'</span><span class="auwb-history-date">'+new Date(e.timestamp).toLocaleString()+'</span></div>'
                +'<div class="auwb-preset-actions">'
                +'<button class="auwb-preset-btn auwb-hist-diff" title="현재와 비교"><i class="fa-solid fa-code-compare"></i></button>'
                +'<button class="auwb-preset-btn auwb-hist-view" title="미리보기"><i class="fa-solid fa-eye"></i></button>'
                +'<button class="auwb-preset-btn auwb-hist-rollback" title="복원"><i class="fa-solid fa-rotate-left"></i></button>'
                +'</div></div>';
        });
        el.innerHTML=html;
        el.querySelectorAll('.auwb-history-item').forEach(function(item){
            var hid=item.getAttribute('data-hid');
            item.querySelector('.auwb-hist-diff').addEventListener('click',function(e){e.stopPropagation();var ent=getHistory().find(function(h){return h.id===hid;});if(ent)showDiffView(ent.snapshot,getFullSnapshot());});
            item.querySelector('.auwb-hist-view').addEventListener('click',function(e){e.stopPropagation();viewHistoryEntry(hid);});
            item.querySelector('.auwb-hist-rollback').addEventListener('click',function(e){e.stopPropagation();if(!confirm('이 버전으로 복원하시겠습니까?'))return;saveToHistory('before-rollback',getFullSnapshot());rollbackToVersion(hid);renderHistoryList();});
        });
    }

    function viewHistoryEntry(hid){
        var entry=getHistory().find(function(h){return h.id===hid;});if(!entry)return;
        var snap=entry.snapshot,text='=== 히스토리 스냅샷 ===\n시간: '+new Date(entry.timestamp).toLocaleString()+'\n유형: '+entry.type+'\n\n';
        getAllSections().forEach(function(sec){text+='--- '+sec.label+' ---\n'+(snap[sec.id]||'(없음)')+'\n\n';});
        if(snap.genrePrompt) text+='--- 장르/톤 ---\n'+snap.genrePrompt+'\n';
        var c=document.getElementById('auwb-preview-content');if(c)c.textContent=text;
        var m=document.getElementById('auwb-preview-modal');if(m)m.style.display='flex';
    }

    /* Presets ------------------------------------------------------------- */
    function renderPresetList(){
        var el=document.getElementById('auwb-preset-list');if(!el)return;
        var ps=getPresets();
        if(!ps.length){el.innerHTML='<div class="auwb-preset-empty">저장된 프리셋이 없습니다.</div>';return;}
        var html='';
        ps.forEach(function(p){
            html+='<div class="auwb-preset-item" data-pid="'+p.id+'"><span class="auwb-preset-name">'+escapeHtml(p.name)+'</span><span class="auwb-preset-date">'+new Date(p.createdAt).toLocaleDateString()+'</span><div class="auwb-preset-actions">'
                +'<button class="auwb-preset-btn load" title="Load"><i class="fa-solid fa-download"></i></button>'
                +'<button class="auwb-preset-btn rename" title="Rename"><i class="fa-solid fa-pen"></i></button>'
                +'<button class="auwb-preset-btn delete" title="Delete"><i class="fa-solid fa-trash"></i></button>'
                +'</div></div>';
        });
        el.innerHTML=html;
        el.querySelectorAll('.auwb-preset-item').forEach(function(item){
            var id=item.getAttribute('data-pid');
            item.querySelector('.load').addEventListener('click',function(e){e.stopPropagation();try{loadPreset(id);showStatus('프리셋 로드 완료!','success');renderPresetList();}catch(err){showStatus('로드 실패: '+err.message,'error');}});
            item.querySelector('.rename').addEventListener('click',function(e){e.stopPropagation();startRenamePreset(item,id);});
            item.querySelector('.delete').addEventListener('click',function(e){e.stopPropagation();if(confirm('삭제?')){try{deletePreset(id);showStatus('삭제됨','success');renderPresetList();}catch(err){showStatus(err.message,'error');}}});
        });
    }
    function startRenamePreset(itemEl,pid){
        var ne=itemEl.querySelector('.auwb-preset-name'),cn=ne.textContent;
        var inp=document.createElement('input');inp.type='text';inp.className='auwb-preset-name-input';inp.value=cn;
        ne.style.display='none';itemEl.insertBefore(inp,ne);inp.focus();inp.select();
        function fin(){var n=inp.value.trim();if(n&&n!==cn){try{renamePreset(pid,n);showStatus('이름 변경됨','success');}catch(_){}}renderPresetList();}
        inp.addEventListener('blur',fin);inp.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();fin();}else if(e.key==='Escape')renderPresetList();});
    }

    /* Import / Export / Clear -------------------------------------------- */
    function exportSettings(){
        var snap=getFullSnapshot(),ci=getCharacterInfo();
        var b=new Blob([JSON.stringify({version:'2.1',exportDate:new Date().toISOString(),characterName:ci.charName,userName:ci.userName,auConcept:getChatData().auConcept||'',data:snap},null,2)],{type:'application/json'});
        var u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='au-wb-'+(ci.charName||'export')+'-'+Date.now()+'.json';document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(u);showStatus('내보내기 완료!','success');
    }
    function importSettings(file){
        var reader=new FileReader();
        reader.onload=function(ev){
            try{
                var d=JSON.parse(ev.target.result);saveToHistory('before-import',getFullSnapshot());
                var imp=d.data||d;
                if(d.auConcept!=null){saveChatData('auConcept',d.auConcept);setVal('auwb-au-concept',d.auConcept);}
                if(imp.auConcept!=null){saveChatData('auConcept',imp.auConcept);setVal('auwb-au-concept',imp.auConcept);}
                Object.keys(imp).forEach(function(k){
                    if(k==='genrePrompt'){saveChatData('genrePrompt',imp[k]);setVal('auwb-genre-prompt',imp[k]);return;}
                    if(k==='auConcept')return;
                    if(k==='worldSetting'){setSectionContent('world',imp[k]);return;}
                    if(k==='characterSettings'){if(imp[k].char)setSectionContent('charSetting',imp[k].char);if(imp[k].user)setSectionContent('userSetting',imp[k].user);return;}
                    if(k==='clothingStyles'){if(imp[k].char)setSectionContent('charClothing',imp[k].char);if(imp[k].user)setSectionContent('userClothing',imp[k].user);return;}
                    setSectionContent(k,imp[k]);
                });
                loadChatDataToUI();showStatus('가져오기 완료!','success');renderHistoryList();
            }catch(_){showStatus('가져오기 실패: 잘못된 JSON','error');}
        };reader.readAsText(file);
    }
    function clearAllSettings(){
        if(!confirm('모든 AU World Builder 설정을 초기화하시겠습니까?'))return;
        saveToHistory('before-clear',getFullSnapshot());
        getAllSections().forEach(function(sec){setSectionContent(sec.id,'');setSectionTextareaValue(sec.id,'');});
        saveChatData('genrePrompt','');saveChatData('auConcept','');
        setVal('auwb-au-concept','');setVal('auwb-genre-prompt','');
        showStatus('모든 설정 초기화됨!','success');renderHistoryList();
    }

    /* ================================================================
       SECTION 19 — UI EVENT BINDING
       ================================================================ */
    function btnLoading(btn,asyncFn){
        if(!btn||btn.disabled)return;btn.disabled=true;var orig=btn.innerHTML;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> 처리 중…';
        asyncFn().catch(function(e){showStatus('실패: '+e.message,'error');}).finally(function(){btn.disabled=false;btn.innerHTML=orig;});
    }
    function withLoading(btnId,asyncFn){
        return async function(){var btn=document.getElementById(btnId);if(!btn||btn.disabled)return;btn.disabled=true;var orig=btn.innerHTML;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> 처리 중…';try{await asyncFn();}catch(e){showStatus('실패: '+e.message,'error');}finally{btn.disabled=false;btn.innerHTML=orig;}};
    }
    function openPopup(){var p=document.getElementById('au-world-builder-popup');if(p){p.style.display='flex';loadSettingsToUI();checkApiStatus();renderPresetList();renderHistoryList();}}
    function bindClick(id,fn){var el=document.getElementById(id);if(el)el.addEventListener('click',fn);}
    function bindChange(id,fn){var el=document.getElementById(id);if(el)el.addEventListener('change',function(){fn(el.checked);});}
    function bindInputChange(id,fn){var el=document.getElementById(id);if(el)el.addEventListener('change',function(){fn(el.value);});}

    function initGenOptions(){
        var maps=[{prefix:'auwb-opt-cliche',key:'cliche',vals:['allow','subvert']},{prefix:'auwb-opt-relation',key:'relation',vals:['first','known']},{prefix:'auwb-opt-original',key:'original',vals:['break','keep']},{prefix:'auwb-opt-mood',key:'mood',vals:['light','dark']}];
        var opts=getSettings().genOptions||{};
        maps.forEach(function(m){m.vals.forEach(function(v){var b=document.getElementById(m.prefix+'-'+v);if(!b)return;if(opts[m.key]===v)b.classList.add('active');else b.classList.remove('active');b.addEventListener('click',function(){m.vals.forEach(function(vv){var bb=document.getElementById(m.prefix+'-'+vv);if(bb)bb.classList.remove('active');});b.classList.add('active');var s=getSettings();if(!s.genOptions)s.genOptions={};s.genOptions[m.key]=v;saveSetting('genOptions',s.genOptions);});});});
    }

    function bindUIEvents(){
        var popup=document.getElementById('au-world-builder-popup');if(!popup)return;

        /* close */
        bindClick('auwb-close',function(){popup.style.display='none';});
        var ov=popup.querySelector('.auwb-popup-overlay');if(ov)ov.addEventListener('click',function(){popup.style.display='none';});

        /* tabs */
        popup.querySelectorAll('.auwb-tab-btn').forEach(function(btn){btn.addEventListener('click',function(){
            var tid=btn.getAttribute('data-tab');
            popup.querySelectorAll('.auwb-tab-btn').forEach(function(b){b.classList.remove('active');});btn.classList.add('active');
            popup.querySelectorAll('.auwb-tab-content').forEach(function(c){c.style.display=c.id==='auwb-tab-'+tid?'block':'none';});
        });});

        /* modals */
        bindClick('auwb-preview-close',function(){document.getElementById('auwb-preview-modal').style.display='none';});
        var pov=document.querySelector('#auwb-preview-modal .auwb-modal-overlay');if(pov)pov.addEventListener('click',function(){document.getElementById('auwb-preview-modal').style.display='none';});
        bindClick('auwb-diff-close',function(){document.getElementById('auwb-diff-modal').style.display='none';});
        var dov=document.querySelector('#auwb-diff-modal .auwb-modal-overlay');if(dov)dov.addEventListener('click',function(){document.getElementById('auwb-diff-modal').style.display='none';});

        initGenOptions();

        /* ---- GENERATE TAB ---- */
        bindClick('auwb-generate-btn',withLoading('auwb-generate-btn',async function(){
            var concept=getElVal('auwb-au-concept').trim();if(!concept){showStatus('AU 컨셉을 입력하세요.','error');return;}
            showStatus('AU 세계 생성 중…','info');saveToHistory('initial',getFullSnapshot());
            var result=await generateAUWorld(concept);if(!result){showStatus('API 응답이 비어있습니다.','error');return;}
            var parsed=parseGeneratedContent(result),eids=getEnabledSections().map(function(s){return s.id;});
            Object.keys(parsed).forEach(function(k){if(eids.indexOf(k)===-1)return;setSectionContent(k,parsed[k]||'');setSectionTextareaValue(k,parsed[k]||'');});
            saveChatData('auConcept',concept);updateExtensionPrompt();updateTokenDisplay();renderHistoryList();renderCustomSectionContent();showStatus('AU 세계 생성 완료!','success');
        }));

        bindClick('auwb-manual-update-btn',withLoading('auwb-manual-update-btn',async function(){
            var s=parseInt(getElVal('auwb-update-start'))||0,e=parseInt(getElVal('auwb-update-end'))||0;
            if(e<s){showStatus('종료 인덱스가 시작보다 커야 합니다.','error');return;}
            showStatus('메시지 분석 중…','info');var result=await updateFromRange(s,e);
            if(result){applyUpdateResult(result,'manual-update');var lu=document.getElementById('auwb-last-update');if(lu)lu.textContent='마지막: '+new Date().toLocaleString()+' (#'+s+'–#'+e+')';}
        }));

        bindClick('auwb-generate-genre-btn',withLoading('auwb-generate-genre-btn',async function(){
            showStatus('장르 프롬프트 생성 중…','info');var r=await generateGenrePromptText();if(r){saveChatData('genrePrompt',r);setVal('auwb-genre-prompt',r);showStatus('장르 프롬프트 생성 완료!','success');}
        }));

        /* selective regen (built-in) */
        [{b:'auwb-regen-world',k:'world'},{b:'auwb-regen-char',k:'charSetting'},{b:'auwb-regen-user',k:'userSetting'},{b:'auwb-regen-char-clothing',k:'charClothing'},{b:'auwb-regen-user-clothing',k:'userClothing'}].forEach(function(x){
            bindClick(x.b,withLoading(x.b,async function(){showStatus('섹션 재생성 중…','info');saveToHistory('regen',getFullSnapshot());var res=await regenerateSection(x.k);if(res&&res.value){setSectionContent(x.k,res.value);setSectionTextareaValue(x.k,res.value);updateExtensionPrompt();updateTokenDisplay();renderHistoryList();showStatus('재생성 완료!','success');}}));
        });

        /* world tab */
        bindClick('auwb-save-world',function(){setSectionContent('world',getElVal('auwb-world-setting-content'));updateExtensionPrompt();updateTokenDisplay();showStatus('세계관 저장됨!','success');});
        /* characters tab */
        bindClick('auwb-save-characters',function(){setSectionContent('charSetting',getElVal('auwb-char-setting-content'));setSectionContent('userSetting',getElVal('auwb-user-setting-content'));updateExtensionPrompt();updateTokenDisplay();showStatus('캐릭터 설정 저장됨!','success');});
        bindClick('auwb-save-styles',function(){setSectionContent('charClothing',getElVal('auwb-char-style-content'));setSectionContent('userClothing',getElVal('auwb-user-style-content'));updateExtensionPrompt();updateTokenDisplay();showStatus('복장 스타일 저장됨!','success');});

        /* settings */
        bindChange('auwb-enabled',function(v){saveSetting('enabled',v);});
        bindChange('auwb-auto-update',function(v){saveSetting('autoUpdateEnabled',v);});
        bindChange('auwb-smart-auto-update',function(v){saveSetting('smartAutoUpdate',v);});
        bindChange('auwb-genre-enabled',function(v){saveSetting('genrePromptEnabled',v);});
        bindChange('auwb-debug-mode',function(v){saveSetting('debugMode',v);});
        bindInputChange('auwb-update-interval',function(v){saveSetting('autoUpdateInterval',parseInt(v)||5);});
        bindInputChange('auwb-output-language',function(v){saveSetting('outputLanguage',v);});
        bindInputChange('auwb-api-source',function(v){saveSetting('apiSource',v);updateApiSettingsVisibility();});
        bindInputChange('auwb-connection-profile',function(v){saveSetting('connectionProfile',v);});
        bindInputChange('auwb-api-url',function(v){saveSetting('customApiUrl',v);});
        bindInputChange('auwb-api-key',function(v){saveSetting('customApiKey',v);});
        bindInputChange('auwb-api-model',function(v){saveSetting('customApiModel',v);});
        bindInputChange('auwb-api-max-tokens',function(v){saveSetting('customApiMaxTokens',parseInt(v)||4000);});
        bindInputChange('auwb-api-timeout',function(v){saveSetting('customApiTimeout',parseInt(v)||120);});

        /* D — add custom section */
        bindClick('auwb-add-custom-section',function(){var n=prompt('새 섹션 이름을 입력하세요:');if(!n||!n.trim())return;addCustomSection(n);renderSectionManager();renderCustomSectionContent();showStatus('커스텀 섹션 추가: '+n,'success');});

        /* H — cleanup */
        bindClick('auwb-cleanup-chatdata',function(){var st=getChatDataStats();if(st.totalEntries<=1){showStatus('정리할 데이터가 없습니다.','info');return;}if(!confirm('현재 채팅을 제외한 '+(st.totalEntries-1)+'개의 채팅 데이터를 삭제하시겠습니까?'))return;var rm=cleanupChatData(true);updateDataStats();showStatus(rm+'개 채팅 데이터 정리됨!','success');});

        /* API */
        bindClick('auwb-test-api-btn',withLoading('auwb-test-api-btn',async function(){showStatus('API 테스트 중…','info');await testApiConnection();showStatus('API 연결 성공!','success');checkApiStatus();}));

        /* actions */
        bindClick('auwb-preview-injection',function(){var c=document.getElementById('auwb-preview-content');if(c)c.textContent=getInjectionPreview();var m=document.getElementById('auwb-preview-modal');if(m)m.style.display='flex';});
        bindClick('auwb-export',exportSettings);
        var impF=document.getElementById('auwb-import-file');
        bindClick('auwb-import',function(){if(impF)impF.click();});
        if(impF)impF.addEventListener('change',function(e){if(e.target.files&&e.target.files[0]){importSettings(e.target.files[0]);e.target.value='';}});
        bindClick('auwb-clear-all',clearAllSettings);
        bindClick('auwb-export-lorebook',exportToLorebook);
        bindClick('auwb-export-lorebook-direct',exportToLorebookDirect);
        bindClick('auwb-save-genre',function(){saveChatData('genrePrompt',getElVal('auwb-genre-prompt'));updateExtensionPrompt();updateTokenDisplay();showStatus('장르 프롬프트 저장됨!','success');});

        /* presets */
        bindClick('auwb-save-preset-btn',function(){var n=getElVal('auwb-preset-name').trim();if(!n){showStatus('이름 필요','error');return;}try{savePreset(n);setVal('auwb-preset-name','');showStatus('프리셋 저장: '+n,'success');renderPresetList();}catch(e){showStatus(e.message,'error');}});
        bindClick('auwb-export-presets',function(){exportPresets();showStatus('프리셋 내보내기 완료!','success');});
        var ipF=document.getElementById('auwb-import-presets-file');
        bindClick('auwb-import-presets',function(){if(ipF)ipF.click();});
        if(ipF)ipF.addEventListener('change',function(e){if(e.target.files&&e.target.files[0]){var r=new FileReader();r.onload=function(ev){try{var c=importPresets(ev.target.result);showStatus(c+'개 프리셋 가져옴!','success');renderPresetList();}catch(err){showStatus(err.message,'error');}};r.readAsText(e.target.files[0]);e.target.value='';}});

        /* custom prompts */
        bindClick('auwb-save-custom-prompts',saveCustomPrompts);
        bindClick('auwb-reset-initial-prompt',function(){resetPromptTemplate('initial');});
        bindClick('auwb-reset-update-prompt',function(){resetPromptTemplate('update');});
        bindClick('auwb-reset-genre-prompt-tmpl',function(){resetPromptTemplate('genre');});
        bindClick('auwb-reset-section-prompt',function(){resetPromptTemplate('section');});
        bindClick('auwb-reset-analysis-prompt',function(){resetPromptTemplate('smartAnalysis');});

        /* load models */
        bindClick('auwb-load-models',async function(){
            try{var s=getSettings(),url=(s.customApiUrl||'').replace(/\/chat\/completions\/?$/,'/models'),hd={};if(s.customApiKey)hd.Authorization='Bearer '+s.customApiKey;var resp=await fetch(url,{headers:hd});if(!resp.ok)throw new Error('HTTP '+resp.status);var d=await resp.json(),models=(d.data||d.models||[]).map(function(m){return m.id||m.name||m;});var dl=document.getElementById('auwb-models-list')||document.createElement('datalist');dl.id='auwb-models-list';dl.innerHTML=models.map(function(m){return '<option value="'+m+'">';}).join('');if(!document.getElementById('auwb-models-list'))document.body.appendChild(dl);var mi=document.getElementById('auwb-api-model');if(mi)mi.setAttribute('list','auwb-models-list');showStatus(models.length+'개 모델 로드됨','success');}
            catch(e){showStatus('모델 로드 실패: '+e.message,'error');}
        });

        renderPresetList(); renderHistoryList(); renderSectionManager(); updateSectionDisabledVisuals();
        log('UI events bound');
    }

    /* ================================================================
       SECTION 20 — EVENT REGISTRATION & INIT
       ================================================================ */
    function registerPromptInjection(){
        try{
            var ctx=SillyTavern.getContext();if(!ctx||!ctx.eventSource||!ctx.event_types)return false;
            ctx.eventSource.on(ctx.event_types.CHAT_CHANGED,function(){log('Chat changed');autoUpdateMessageCount=0;loadChatDataToUI();});
            ctx.eventSource.on(ctx.event_types.GENERATION_STARTED,function(){updateExtensionPrompt();});
            ctx.eventSource.on(ctx.event_types.CHARACTER_MESSAGE_RENDERED,function(){
                updateExtensionPrompt();
                var s=getSettings();if(!s.autoUpdateEnabled)return;
                autoUpdateMessageCount++;
                if(autoUpdateMessageCount>=(s.autoUpdateInterval||5)){autoUpdateMessageCount=0;triggerAutoUpdate(s.autoUpdateInterval||5);}
            });
            log('Event listeners registered');return true;
        }catch(e){logError('registerPromptInjection',e);return false;}
    }

    async function loadPopupHTML(){
        var paths=[extFolderPath+'/popup.html','scripts/extensions/third-party/AU-World-Builder/popup.html','data/default-user/extensions/AU-World-Builder/popup.html'];
        for(var i=0;i<paths.length;i++){try{var html=await $.get(paths[i]);$('body').append(html);log('Popup loaded: '+paths[i]);return true;}catch(_){}}
        logError('Failed to load popup.html');return false;
    }
    function loadCSS(){
        var paths=[extFolderPath+'/style.css','scripts/extensions/third-party/AU-World-Builder/style.css','data/default-user/extensions/AU-World-Builder/style.css'];
        for(var i=0;i<paths.length;i++){var l=document.createElement('link');l.rel='stylesheet';l.href=paths[i];document.head.appendChild(l);return;}
    }
    function addExtMenuButton(){
        var retries=0;
        function tryAdd(){if(document.getElementById('au-world-builder-menu-item'))return;var menu=document.getElementById('extensionsMenu');if(!menu){if(retries++<20)setTimeout(tryAdd,500);return;}
            var item=document.createElement('div');item.id='au-world-builder-menu-item';item.className='list-group-item flex-container flexGap5 interactable';item.tabIndex=0;item.role='listitem';
            item.innerHTML='<div class="fa-solid fa-globe extensionsMenuExtensionButton"></div> AU World Builder';
            item.addEventListener('click',function(){openPopup();jQuery('#extensionsMenu').hide();});menu.appendChild(item);}
        tryAdd();
    }

    async function init(){
        log('=== AU World Builder v2.1 Initializing ===');
        try{getSettings();loadCSS();await loadPopupHTML();addExtMenuButton();bindUIEvents();
            var ok=registerPromptInjection();if(ok)updateExtensionPrompt();else setTimeout(function(){if(registerPromptInjection())updateExtensionPrompt();},2000);
            log('=== Initialization Complete ===');
        }catch(e){logError('Init failed',e);}
    }

    jQuery(function(){init();});
    window.AUWorldBuilder={openPopup:openPopup,getSettings:getSettings,updateExtensionPrompt:updateExtensionPrompt};
})();
