<!-- AU World Builder v2.0 Popup -->
<div id="au-world-builder-popup" class="auwb-popup" style="display: none;">
    <div class="auwb-popup-overlay"></div>
    <div class="auwb-popup-container">
        <!-- Header -->
        <div class="auwb-popup-header">
            <div class="auwb-header-title">
                <i class="fa-solid fa-globe"></i>
                <span>AU World Builder</span>
                <span id="auwb-token-display" class="auwb-token-badge">~0 tokens</span>
            </div>
            <button id="auwb-close" class="auwb-close-btn">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Status Message -->
        <div id="auwb-status-message" class="auwb-status-message" style="display: none;"></div>

        <!-- Tabs -->
        <div class="auwb-tabs">
            <button class="auwb-tab-btn active" data-tab="generate">
                <i class="fa-solid fa-wand-magic-sparkles"></i> 생성
            </button>
            <button class="auwb-tab-btn" data-tab="world">
                <i class="fa-solid fa-earth-americas"></i> 세계관
            </button>
            <button class="auwb-tab-btn" data-tab="characters">
                <i class="fa-solid fa-users"></i> 캐릭터
            </button>
            <button class="auwb-tab-btn" data-tab="settings">
                <i class="fa-solid fa-gear"></i> 설정
            </button>
            <button class="auwb-tab-btn" data-tab="preset">
                <i class="fa-solid fa-bookmark"></i> 프리셋
            </button>
            <button class="auwb-tab-btn" data-tab="prompts">
                <i class="fa-solid fa-code"></i> 프롬프트
            </button>
            <button class="auwb-tab-btn" data-tab="history">
                <i class="fa-solid fa-clock-rotate-left"></i> 히스토리
            </button>
        </div>

        <!-- Tab Contents -->
        <div class="auwb-popup-content">

            <!-- ============ GENERATE TAB ============ -->
            <div id="auwb-tab-generate" class="auwb-tab-content" style="display: block;">

                <!-- Main Toggle -->
                <div class="auwb-section">
                    <div class="auwb-toggle-row">
                        <label class="auwb-toggle">
                            <input type="checkbox" id="auwb-enabled" checked>
                            <span class="auwb-toggle-slider"></span>
                        </label>
                        <span class="auwb-toggle-label">AU World 주입 활성화</span>
                    </div>
                </div>

                <!-- AU Concept Input -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-lightbulb"></i> AU 컨셉</h4>
                    <p class="auwb-hint">대체 우주(AU) 아이디어를 설명하세요 (예: "디스토피아 판타지 SF 세계", "뱀파이어 판타지 세계")</p>
                    <textarea id="auwb-au-concept" class="auwb-textarea" rows="3" placeholder="AU 컨셉을 입력하세요..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-generate-btn" class="auwb-btn auwb-btn-primary">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> AU 세계 생성
                        </button>
                    </div>
                </div>

                <!-- Generation Options -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-sliders"></i> 생성 옵션</h4>
                    <div class="auwb-option-grid">
                        <div class="auwb-option-item">
                            <span class="auwb-option-label">클리셰 설정</span>
                            <div class="auwb-option-toggle">
                                <button id="auwb-opt-cliche-allow" class="auwb-opt-btn active" data-value="allow">허용</button>
                                <button id="auwb-opt-cliche-subvert" class="auwb-opt-btn" data-value="subvert">비틀기</button>
                            </div>
                        </div>
                        <div class="auwb-option-item">
                            <span class="auwb-option-label">관계 설정</span>
                            <div class="auwb-option-toggle">
                                <button id="auwb-opt-relation-first" class="auwb-opt-btn active" data-value="first">초면</button>
                                <button id="auwb-opt-relation-known" class="auwb-opt-btn" data-value="known">구면</button>
                            </div>
                        </div>
                        <div class="auwb-option-item">
                            <span class="auwb-option-label">원작 설정</span>
                            <div class="auwb-option-toggle">
                                <button id="auwb-opt-original-break" class="auwb-opt-btn active" data-value="break">원작 탈피</button>
                                <button id="auwb-opt-original-keep" class="auwb-opt-btn" data-value="keep">원작 반영</button>
                            </div>
                        </div>
                        <div class="auwb-option-item">
                            <span class="auwb-option-label">분위기 설정</span>
                            <div class="auwb-option-toggle">
                                <button id="auwb-opt-mood-light" class="auwb-opt-btn active" data-value="light">밝은 분위기</button>
                                <button id="auwb-opt-mood-dark" class="auwb-opt-btn" data-value="dark">어두운 분위기</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- API Status -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-plug"></i> API 상태</h4>
                    <div id="auwb-api-status" class="auwb-api-status">
                        <span class="auwb-status-indicator"></span>
                        <span>확인 중…</span>
                    </div>
                </div>

                <!-- Manual Update -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-arrows-rotate"></i> 수동 업데이트</h4>
                    <p class="auwb-hint">특정 메시지 범위를 기반으로 세계관/캐릭터 설정을 업데이트합니다.</p>
                    <div class="auwb-update-range">
                        <div class="auwb-range-input">
                            <label>시작 #</label>
                            <input type="number" id="auwb-update-start" min="0" value="0">
                        </div>
                        <span class="auwb-range-separator">~</span>
                        <div class="auwb-range-input">
                            <label>종료 #</label>
                            <input type="number" id="auwb-update-end" min="0" value="0">
                        </div>
                        <div class="auwb-chat-info">
                            현재 메시지 수: <span id="auwb-chat-length">0</span>
                        </div>
                    </div>
                    <div class="auwb-btn-group">
                        <button id="auwb-manual-update-btn" class="auwb-btn auwb-btn-secondary">
                            <i class="fa-solid fa-arrows-rotate"></i> 범위에서 업데이트
                        </button>
                    </div>
                    <p class="auwb-hint" id="auwb-last-update">아직 업데이트되지 않음</p>
                </div>

                <!-- Auto Update -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-robot"></i> 자동 업데이트</h4>
                    <div class="auwb-toggle-row">
                        <label class="auwb-toggle">
                            <input type="checkbox" id="auwb-auto-update">
                            <span class="auwb-toggle-slider"></span>
                        </label>
                        <span class="auwb-toggle-label">자동 업데이트 활성화</span>
                    </div>
                    <div class="auwb-input-row">
                        <label>매</label>
                        <input type="number" id="auwb-update-interval" min="1" max="50" value="5" class="auwb-small-input">
                        <label>메시지마다 업데이트</label>
                    </div>
                    <div class="auwb-toggle-row" style="margin-top: 8px;">
                        <label class="auwb-toggle">
                            <input type="checkbox" id="auwb-smart-auto-update" checked>
                            <span class="auwb-toggle-slider"></span>
                        </label>
                        <span class="auwb-toggle-label">스마트 분석 (변경 감지 시에만 업데이트)</span>
                    </div>
                </div>

                <!-- Genre/Tone -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-pen-fancy"></i> 장르 및 톤 프롬프트</h4>
                    <div class="auwb-toggle-row">
                        <label class="auwb-toggle">
                            <input type="checkbox" id="auwb-genre-enabled">
                            <span class="auwb-toggle-slider"></span>
                        </label>
                        <span class="auwb-toggle-label">장르 프롬프트 주입 활성화</span>
                    </div>
                    <textarea id="auwb-genre-prompt" class="auwb-textarea" rows="2" placeholder="장르/톤 프롬프트가 여기에 표시됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-generate-genre-btn" class="auwb-btn auwb-btn-secondary">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> 장르 프롬프트 생성
                        </button>
                        <button id="auwb-save-genre" class="auwb-btn auwb-btn-secondary">
                            <i class="fa-solid fa-floppy-disk"></i> 저장
                        </button>
                    </div>
                </div>

                <!-- Actions -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-ellipsis"></i> 작업</h4>
                    <div class="auwb-btn-group auwb-btn-grid">
                        <button id="auwb-preview-injection" class="auwb-btn auwb-btn-secondary">
                            <i class="fa-solid fa-eye"></i> 주입 미리보기
                        </button>
                        <button id="auwb-export" class="auwb-btn auwb-btn-secondary">
                            <i class="fa-solid fa-download"></i> 내보내기
                        </button>
                        <button id="auwb-import" class="auwb-btn auwb-btn-secondary">
                            <i class="fa-solid fa-upload"></i> 가져오기
                        </button>
                        <button id="auwb-export-lorebook" class="auwb-btn auwb-btn-secondary" title="World Info JSON 파일로 내보내기">
                            <i class="fa-solid fa-book-atlas"></i> WI 내보내기
                        </button>
                        <button id="auwb-export-lorebook-direct" class="auwb-btn auwb-btn-secondary" title="현재 World Info에 직접 추가 시도">
                            <i class="fa-solid fa-book-medical"></i> WI 직접 추가
                        </button>
                        <button id="auwb-clear-all" class="auwb-btn auwb-btn-danger">
                            <i class="fa-solid fa-trash"></i> 모두 지우기
                        </button>
                    </div>
                    <input type="file" id="auwb-import-file" accept=".json" style="display: none;">
                </div>
            </div>

            <!-- ============ WORLD TAB ============ -->
            <div id="auwb-tab-world" class="auwb-tab-content" style="display: none;">
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-earth-americas"></i> 세계관 설정</h4>
                    <p class="auwb-hint">AU 세계의 개요입니다. 직접 편집할 수 있습니다.</p>
                    <textarea id="auwb-world-setting-content" class="auwb-textarea auwb-large" rows="10" placeholder="세계관 설정이 여기에 표시됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-save-world" class="auwb-btn auwb-btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> 세계관 설정 저장
                        </button>
                        <button id="auwb-regen-world" class="auwb-btn auwb-btn-secondary">
                            <i class="fa-solid fa-rotate"></i> 세계관만 재생성
                        </button>
                    </div>
                </div>
            </div>

            <!-- ============ CHARACTERS TAB ============ -->
            <div id="auwb-tab-characters" class="auwb-tab-content" style="display: none;">

                <div class="auwb-section">
                    <h4><i class="fa-solid fa-user"></i> <span class="auwb-char-name">{{char}}</span>의 설정</h4>
                    <textarea id="auwb-char-setting-content" class="auwb-textarea" rows="6" placeholder="캐릭터 설정이 여기에 표시됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-regen-char" class="auwb-btn auwb-btn-secondary auwb-btn-sm">
                            <i class="fa-solid fa-rotate"></i> 재생성
                        </button>
                    </div>
                </div>

                <div class="auwb-section">
                    <h4><i class="fa-solid fa-user"></i> <span class="auwb-user-name">{{user}}</span>의 설정</h4>
                    <textarea id="auwb-user-setting-content" class="auwb-textarea" rows="6" placeholder="유저 설정이 여기에 표시됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-regen-user" class="auwb-btn auwb-btn-secondary auwb-btn-sm">
                            <i class="fa-solid fa-rotate"></i> 재생성
                        </button>
                    </div>
                </div>

                <div class="auwb-btn-group">
                    <button id="auwb-save-characters" class="auwb-btn auwb-btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> 캐릭터 설정 저장
                    </button>
                </div>

                <div class="auwb-section" style="margin-top: 16px;">
                    <h4><i class="fa-solid fa-shirt"></i> <span class="auwb-char-name">{{char}}</span>의 복장 스타일</h4>
                    <textarea id="auwb-char-style-content" class="auwb-textarea" rows="4" placeholder="복장 스타일이 여기에 표시됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-regen-char-clothing" class="auwb-btn auwb-btn-secondary auwb-btn-sm">
                            <i class="fa-solid fa-rotate"></i> 재생성
                        </button>
                    </div>
                </div>

                <div class="auwb-section">
                    <h4><i class="fa-solid fa-shirt"></i> <span class="auwb-user-name">{{user}}</span>의 복장 스타일</h4>
                    <textarea id="auwb-user-style-content" class="auwb-textarea" rows="4" placeholder="복장 스타일이 여기에 표시됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-regen-user-clothing" class="auwb-btn auwb-btn-secondary auwb-btn-sm">
                            <i class="fa-solid fa-rotate"></i> 재생성
                        </button>
                    </div>
                </div>

                <div class="auwb-btn-group">
                    <button id="auwb-save-styles" class="auwb-btn auwb-btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> 복장 스타일 저장
                    </button>
                </div>
            </div>

            <!-- ============ SETTINGS TAB ============ -->
            <div id="auwb-tab-settings" class="auwb-tab-content" style="display: none;">

                <!-- Output Language -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-language"></i> 출력 언어</h4>
                    <select id="auwb-output-language" class="auwb-select">
                        <option value="korean">한국어</option>
                        <option value="english">English</option>
                    </select>
                </div>

                <!-- Injection Controls (#6) -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-syringe"></i> 주입 설정</h4>
                    <p class="auwb-hint">AU 콘텐츠가 프롬프트에 주입되는 방식을 세밀하게 조절합니다.</p>

                    <div class="auwb-input-group">
                        <label>주입 위치</label>
                        <select id="auwb-injection-position" class="auwb-select">
                            <option value="0">Before Main Prompt</option>
                            <option value="1" selected>In-Chat (@ depth)</option>
                            <option value="2">After Main Prompt</option>
                        </select>
                    </div>

                    <div class="auwb-input-row" style="margin-bottom: 12px;">
                        <div class="auwb-input-group auwb-half">
                            <label>Depth (In-Chat 전용)</label>
                            <input type="number" id="auwb-injection-depth" class="auwb-input" value="4" min="0" max="999">
                        </div>
                        <div class="auwb-input-group auwb-half">
                            <label>Role</label>
                            <select id="auwb-injection-role" class="auwb-select">
                                <option value="0" selected>System</option>
                                <option value="1">User</option>
                                <option value="2">Assistant</option>
                            </select>
                        </div>
                    </div>

                    <h4 style="margin-top: 16px;"><i class="fa-solid fa-toggle-on"></i> 섹션별 주입 토글</h4>
                    <p class="auwb-hint">각 섹션의 주입 여부를 개별적으로 제어합니다.</p>
                    <div class="auwb-toggle-grid">
                        <div class="auwb-toggle-row">
                            <label class="auwb-toggle"><input type="checkbox" id="auwb-inject-world" checked><span class="auwb-toggle-slider"></span></label>
                            <span class="auwb-toggle-label">세계관</span>
                        </div>
                        <div class="auwb-toggle-row">
                            <label class="auwb-toggle"><input type="checkbox" id="auwb-inject-char" checked><span class="auwb-toggle-slider"></span></label>
                            <span class="auwb-toggle-label"><span class="auwb-char-name">{{char}}</span> 설정</span>
                        </div>
                        <div class="auwb-toggle-row">
                            <label class="auwb-toggle"><input type="checkbox" id="auwb-inject-user" checked><span class="auwb-toggle-slider"></span></label>
                            <span class="auwb-toggle-label"><span class="auwb-user-name">{{user}}</span> 설정</span>
                        </div>
                        <div class="auwb-toggle-row">
                            <label class="auwb-toggle"><input type="checkbox" id="auwb-inject-char-clothing" checked><span class="auwb-toggle-slider"></span></label>
                            <span class="auwb-toggle-label"><span class="auwb-char-name">{{char}}</span> 복장</span>
                        </div>
                        <div class="auwb-toggle-row">
                            <label class="auwb-toggle"><input type="checkbox" id="auwb-inject-user-clothing" checked><span class="auwb-toggle-slider"></span></label>
                            <span class="auwb-toggle-label"><span class="auwb-user-name">{{user}}</span> 복장</span>
                        </div>
                        <div class="auwb-toggle-row">
                            <label class="auwb-toggle"><input type="checkbox" id="auwb-inject-genre" checked><span class="auwb-toggle-slider"></span></label>
                            <span class="auwb-toggle-label">장르/톤</span>
                        </div>
                    </div>
                </div>

                <!-- API Source -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-plug"></i> API 소스</h4>
                    <select id="auwb-api-source" class="auwb-select">
                        <option value="sillytavern">SillyTavern API</option>
                        <option value="custom">커스텀 API</option>
                    </select>
                </div>

                <!-- ST API Settings -->
                <div id="auwb-st-api-settings" class="auwb-section">
                    <h4><i class="fa-solid fa-link"></i> 연결 프로필</h4>
                    <select id="auwb-connection-profile" class="auwb-select">
                        <option value="">현재 API 연결 사용</option>
                    </select>
                </div>

                <!-- Custom API Settings -->
                <div id="auwb-custom-api-settings" class="auwb-section" style="display: none;">
                    <h4><i class="fa-solid fa-server"></i> 커스텀 API 설정</h4>
                    <div class="auwb-input-group">
                        <label>API URL</label>
                        <input type="text" id="auwb-api-url" class="auwb-input" placeholder="https://api.openai.com/v1/chat/completions">
                    </div>
                    <div class="auwb-input-group">
                        <label>API 키</label>
                        <input type="password" id="auwb-api-key" class="auwb-input" placeholder="sk-...">
                    </div>
                    <div class="auwb-input-group">
                        <label>모델</label>
                        <div class="auwb-input-with-btn">
                            <input type="text" id="auwb-api-model" class="auwb-input" placeholder="gpt-4">
                            <button id="auwb-load-models" class="auwb-btn auwb-btn-secondary">
                                <i class="fa-solid fa-list"></i>
                            </button>
                        </div>
                    </div>
                    <div class="auwb-input-row">
                        <div class="auwb-input-group auwb-half">
                            <label>최대 토큰</label>
                            <input type="number" id="auwb-api-max-tokens" class="auwb-input" value="4000" min="100" max="32000">
                        </div>
                        <div class="auwb-input-group auwb-half">
                            <label>타임아웃 (초)</label>
                            <input type="number" id="auwb-api-timeout" class="auwb-input" value="120" min="10" max="600">
                        </div>
                    </div>
                </div>

                <!-- Test API -->
                <div class="auwb-section">
                    <div class="auwb-btn-group">
                        <button id="auwb-test-api-btn" class="auwb-btn auwb-btn-primary">
                            <i class="fa-solid fa-vial"></i> API 연결 테스트
                        </button>
                    </div>
                </div>

                <!-- Debug -->
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-bug"></i> 디버그</h4>
                    <div class="auwb-toggle-row">
                        <label class="auwb-toggle">
                            <input type="checkbox" id="auwb-debug-mode">
                            <span class="auwb-toggle-slider"></span>
                        </label>
                        <span class="auwb-toggle-label">디버그 모드 활성화</span>
                    </div>
                </div>
            </div>

            <!-- ============ PRESET TAB ============ -->
            <div id="auwb-tab-preset" class="auwb-tab-content" style="display: none;">
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-plus"></i> 현재 설정을 프리셋으로 저장</h4>
                    <div class="auwb-input-with-btn">
                        <input type="text" id="auwb-preset-name" class="auwb-input" placeholder="프리셋 이름을 입력하세요...">
                        <button id="auwb-save-preset-btn" class="auwb-btn auwb-btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> 저장
                        </button>
                    </div>
                </div>
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-list"></i> 저장된 프리셋</h4>
                    <div id="auwb-preset-list" class="auwb-preset-list">
                        <div class="auwb-preset-empty">저장된 프리셋이 없습니다.</div>
                    </div>
                </div>
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-file-import"></i> 프리셋 가져오기/내보내기</h4>
                    <div class="auwb-btn-group">
                        <button id="auwb-export-presets" class="auwb-btn auwb-btn-secondary">
                            <i class="fa-solid fa-download"></i> 모든 프리셋 내보내기
                        </button>
                        <button id="auwb-import-presets" class="auwb-btn auwb-btn-secondary">
                            <i class="fa-solid fa-upload"></i> 프리셋 가져오기
                        </button>
                    </div>
                    <input type="file" id="auwb-import-presets-file" accept=".json" style="display: none;">
                </div>
            </div>

            <!-- ============ PROMPT TAB (#5) ============ -->
            <div id="auwb-tab-prompts" class="auwb-tab-content" style="display: none;">
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-code"></i> 프롬프트 템플릿 편집기</h4>
                    <p class="auwb-hint">
                        각 생성 단계에 사용되는 프롬프트를 커스터마이즈 할 수 있습니다.<br>
                        비워두면 기본 템플릿이 사용됩니다.<br>
                        <strong>사용 가능한 변수:</strong>
                        <code>{{CONCEPT}}</code>, <code>{{CHAR_NAME}}</code>, <code>{{USER_NAME}}</code>,
                        <code>{{CHAR_DESC}}</code>, <code>{{CHAR_PERS}}</code>, <code>{{CHAR_SCENE}}</code>,
                        <code>{{USER_PERSONA}}</code>, <code>{{GUIDELINES}}</code>, <code>{{LANG_INSTRUCTION}}</code>,
                        <code>{{CURRENT_WORLD}}</code>, <code>{{CURRENT_CHAR}}</code>, <code>{{CURRENT_USER}}</code>,
                        <code>{{MESSAGES}}</code>, <code>{{START}}</code>, <code>{{END}}</code>
                    </p>
                </div>

                <div class="auwb-section">
                    <h4>초기 생성 프롬프트</h4>
                    <textarea id="auwb-custom-initial-prompt" class="auwb-textarea auwb-large" rows="8" placeholder="비워두면 기본 템플릿이 사용됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-reset-initial-prompt" class="auwb-btn auwb-btn-secondary auwb-btn-sm">
                            <i class="fa-solid fa-rotate-left"></i> 기본값 복원
                        </button>
                    </div>
                </div>

                <div class="auwb-section">
                    <h4>업데이트 프롬프트</h4>
                    <textarea id="auwb-custom-update-prompt" class="auwb-textarea" rows="6" placeholder="비워두면 기본 템플릿이 사용됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-reset-update-prompt" class="auwb-btn auwb-btn-secondary auwb-btn-sm">
                            <i class="fa-solid fa-rotate-left"></i> 기본값 복원
                        </button>
                    </div>
                </div>

                <div class="auwb-section">
                    <h4>장르/톤 생성 프롬프트</h4>
                    <textarea id="auwb-custom-genre-prompt" class="auwb-textarea" rows="4" placeholder="비워두면 기본 템플릿이 사용됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-reset-genre-prompt-tmpl" class="auwb-btn auwb-btn-secondary auwb-btn-sm">
                            <i class="fa-solid fa-rotate-left"></i> 기본값 복원
                        </button>
                    </div>
                </div>

                <div class="auwb-section">
                    <h4>섹션 재생성 프롬프트</h4>
                    <textarea id="auwb-custom-section-prompt" class="auwb-textarea" rows="5" placeholder="비워두면 기본 템플릿이 사용됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-reset-section-prompt" class="auwb-btn auwb-btn-secondary auwb-btn-sm">
                            <i class="fa-solid fa-rotate-left"></i> 기본값 복원
                        </button>
                    </div>
                </div>

                <div class="auwb-section">
                    <h4>스마트 분석 프롬프트</h4>
                    <p class="auwb-hint">자동 업데이트 전 변경 감지에 사용됩니다.</p>
                    <textarea id="auwb-custom-analysis-prompt" class="auwb-textarea" rows="4" placeholder="비워두면 기본 템플릿이 사용됩니다..."></textarea>
                    <div class="auwb-btn-group">
                        <button id="auwb-reset-analysis-prompt" class="auwb-btn auwb-btn-secondary auwb-btn-sm">
                            <i class="fa-solid fa-rotate-left"></i> 기본값 복원
                        </button>
                    </div>
                </div>

                <div class="auwb-section">
                    <div class="auwb-btn-group">
                        <button id="auwb-save-custom-prompts" class="auwb-btn auwb-btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> 모든 프롬프트 저장
                        </button>
                    </div>
                </div>
            </div>

            <!-- ============ HISTORY TAB (#3) ============ -->
            <div id="auwb-tab-history" class="auwb-tab-content" style="display: none;">
                <div class="auwb-section">
                    <h4><i class="fa-solid fa-clock-rotate-left"></i> 생성 히스토리</h4>
                    <p class="auwb-hint">이전 버전을 미리보고 복원할 수 있습니다. 최대 20개 보관됩니다.</p>
                    <div id="auwb-history-list" class="auwb-preset-list">
                        <div class="auwb-preset-empty">히스토리가 없습니다.</div>
                    </div>
                </div>
            </div>

        </div><!-- .auwb-popup-content -->
    </div><!-- .auwb-popup-container -->

    <!-- Preview Modal -->
    <div id="auwb-preview-modal" class="auwb-modal" style="display: none;">
        <div class="auwb-modal-overlay"></div>
        <div class="auwb-modal-content">
            <div class="auwb-modal-header">
                <h4><i class="fa-solid fa-eye"></i> 미리보기</h4>
                <button id="auwb-preview-close" class="auwb-modal-close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="auwb-modal-body">
                <pre id="auwb-preview-content" class="auwb-preview-text"></pre>
            </div>
        </div>
    </div>
</div>
